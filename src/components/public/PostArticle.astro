---
/**
 * DEFAULT `PostArticle` slot — the single-post view.
 *
 * Built-in implementation; a theme replaces it by exporting its own
 * `PostArticle`. Extracted verbatim from /blog/[slug] so adopting slots changed
 * no markup.
 *
 * `contentHtml` arrives ALREADY sanitized (the page sanitizes after plugin
 * filters run). Render it with set:html and do not re-sanitize or escape it.
 */
import type { PostArticleProps } from '../../core/theme-slots';
import { routeHref } from '../../lib/locale-links';

const { post, contentHtml, author, category, date, readTime } = Astro.props as PostArticleProps;

---

<article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <header class="mb-8">
    <div class="mb-4">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
        {category}
      </span>
    </div>
    
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 leading-tight">
      {post.title}
    </h1>
    
    <div class="flex items-center space-x-6 text-gray-600 mb-6">
      <div class="flex items-center space-x-2">
        <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center">
          <span class="text-white font-medium">
            {author.split(' ').map((n: string) => n[0]).join('')}
          </span>
        </div>
        <span class="font-medium">{author}</span>
      </div>
      <time>{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      <span>{readTime} min read</span>
    </div>
    
    {post.featured_image && (
      <div class="mb-8">
        <!--
          NOT lazy. This is the article's hero and almost always the Largest
          Contentful Paint element; lazy-loading it delays the very measurement
          it would look like it was helping. eager + high priority is the
          opposite instruction, and the correct one.
        -->
        <img
          src={post.featured_image}
          alt={post.title}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-64 md:h-96 object-cover rounded-xl shadow-lg"
        />
      </div>
    )}
  </header>

  <div class="prose prose-lg max-w-none">
    <div set:html={contentHtml} />
  </div>

  <!-- Share links and "back to blog" are chrome: useless on paper, and the
       print rules already drop every other piece of navigation. -->
  <footer class="no-print mt-12 pt-8 border-t border-gray-200">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <span class="text-gray-600">Share this article:</span>
        <div class="flex space-x-2">
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(Astro.url.href)}`} 
             target="_blank" 
             class="p-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M6.29 18.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0020 3.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.073 4.073 0 01.8 7.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 010 16.407a11.616 11.616 0 006.29 1.84"/>
            </svg>
          </a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} 
             target="_blank" 
             class="p-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M20 10c0-5.523-4.477-10-10-10S0 4.477 0 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V10h2.54V7.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V10h2.773l-.443 2.89h-2.33v6.988C16.343 19.128 20 14.991 20 10z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} 
             target="_blank" 
             class="p-2 bg-blue-700 text-white rounded-lg hover:bg-blue-800 transition-colors duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
      </div>
      <a href={routeHref('/blog', Astro.locals.locale)} class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium">
        ← Back to Blog
      </a>
    </div>
  </footer>
</article>
