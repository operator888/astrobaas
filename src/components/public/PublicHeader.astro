---
import ThemeToggle from '../ThemeToggle.astro';
import { LocalDB } from '../../lib/localdb';
import type { HeaderProps } from '../../core/theme-slots';
import LocaleSwitcher from './LocaleSwitcher.astro';
import { routeHref } from '../../lib/locale-links';
import type { ResolvedNavItem } from '../../lib/navigation';

interface Props {
  siteTitle?: string;
}
const { siteTitle = 'AstroBaaS', localeOptions, navigation = [] } = Astro.props as HeaderProps;

// The toggle only appears when the theme opts into 'auto'. A site pinned to
// light or dark has nothing to switch, and offering a control that contradicts
// the operator's choice is worse than offering none.
let showThemeToggle = false;
try {
  const theme = await LocalDB.getActiveTheme();
  showThemeToggle = theme?.settings?.colorScheme === 'auto';
} catch { /* DB not ready — hide it rather than fail the header */ }

// Every nav link carries the locale the reader is already in. Built ONCE here
// rather than inline per link, because the desktop and mobile menus repeat the
// same four routes and the two drifting apart is how half a nav ends up
// dropping the reader back into the default language.
const loc = Astro.locals.locale;
const nav = {
  home: routeHref('/', loc),
  blog: routeHref('/blog', loc),
  about: routeHref('/about', loc),
  contact: routeHref('/contact', loc),
};

// The operator's menu when there is one, and these four otherwise. The four are
// expressed as the SAME data the menu is, so desktop and mobile each render
// from one template instead of two — the drift between two copies of a nav is
// exactly how one of them ends up dropping the reader's language.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const builtIn: ResolvedNavItem[] = [
  { label: 'Home', href: nav.home },
  { label: 'Blog', href: nav.blog },
  { label: 'About', href: nav.about },
  { label: 'Contact', href: nav.contact },
].map((l) => ({
  ...l,
  external: false,
  newTab: false,
  current: (l.href.replace(/\/+$/, '') || '/') === here,
  children: [],
}));
const items: ResolvedNavItem[] = navigation.length > 0 ? navigation : builtIn;
---

<header class="ab-site-header bg-white shadow-sm border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <a href={nav.home} class="flex items-center space-x-2">
          <svg class="w-8 h-8 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="text-xl font-bold text-gray-900">{siteTitle}</span>
        </a>
      </div>
      
      <!-- Navigation -->
      <nav class="no-print hidden md:flex items-center space-x-2" aria-label="Main">
        {items.map((item) => (
          <div class="ab-nav-item relative">
            <a
              href={item.href}
              class="inline-flex items-center gap-1 text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 aria-[current=page]:text-blue-700"
              aria-current={item.current ? 'page' : undefined}
              target={item.newTab ? '_blank' : undefined}
              rel={item.newTab ? 'noopener' : undefined}
            >
              {item.label}
              {item.newTab && <span class="sr-only"> (opens in a new tab)</span>}
              {item.children.length > 0 && (
                <svg class="w-3 h-3" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              )}
            </a>
            {item.children.length > 0 && (
              <ul class="ab-nav-sub absolute left-0 top-full z-20 min-w-[12rem] rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-blue-600"
                      aria-current={child.current ? 'page' : undefined}
                      target={child.newTab ? '_blank' : undefined}
                      rel={child.newTab ? 'noopener' : undefined}
                    >
                      {child.label}
                      {child.newTab && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </nav>
      
      <!-- CTA Button -->
      <div class="flex items-center space-x-4">
        <LocaleSwitcher options={localeOptions} />
        {showThemeToggle && <ThemeToggle />}
        <a href="/admin" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200">
          Admin
        </a>
        
        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden p-2 rounded-md text-gray-700 hover:text-blue-600 hover:bg-gray-100"
          aria-label="Menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile Navigation -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4" aria-label="Main">
      <ul class="space-y-1">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="block text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-base font-medium"
              aria-current={item.current ? 'page' : undefined}
              target={item.newTab ? '_blank' : undefined}
              rel={item.newTab ? 'noopener' : undefined}
            >
              {item.label}
              {item.newTab && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
            {item.children.length > 0 && (
              <ul class="ml-4 border-l border-gray-200 pl-2">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block text-gray-600 hover:text-blue-600 px-3 py-2 rounded-md text-sm"
                      aria-current={child.current ? 'page' : undefined}
                      target={child.newTab ? '_blank' : undefined}
                      rel={child.newTab ? 'noopener' : undefined}
                    >
                      {child.label}
                      {child.newTab && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuToggle && mobileMenu) {
      mobileMenuToggle.addEventListener('click', () => {
        const open = mobileMenu.classList.toggle('hidden') === false;
        // Say so. Without aria-expanded a screen reader announces "Menu,
        // button" and never whether pressing it opened or closed anything.
        mobileMenuToggle.setAttribute('aria-expanded', String(open));
      });
    }
  });
</script>

<style>
  /* The headerStyle token finally does something. `layout.headerStyle` was
     deleted by migration v3 precisely because it was config with no consumer;
     this is the consumer. */
  .ab-site-header { border-bottom-width: var(--header-border, 1px); }

  /*
   * A submenu opens on hover AND on focus-within. Hover alone is the classic
   * dropdown that a keyboard user can never reach; focus-within opens it the
   * moment the parent link is tabbed to, and keeps it open while focus moves
   * through the children. No script, so nothing for the CSP to refuse.
   */
  .ab-nav-sub { display: none; }
  .ab-nav-item:hover > .ab-nav-sub,
  .ab-nav-item:focus-within > .ab-nav-sub { display: block; }
  .ab-site-header > div > div {
    padding-top: var(--header-pad, 0);
    padding-bottom: var(--header-pad, 0);
    flex-direction: var(--header-direction, row);
    justify-content: var(--header-align, space-between);
    gap: var(--space-2);
    height: auto;
    min-height: 4rem;
  }
</style>
