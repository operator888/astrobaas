---
/**
 * Bulk edit for the products list.
 *
 * The list's rows carry a checkbox (`.bulk-pick`, value = product id); this bar
 * counts them, collects ONE kind of change at a time, and always PREVIEWS before
 * it applies — the server's preview, not a guess made here, so what the operator
 * approves is exactly what `POST /api/product-bulk` will do.
 *
 * One change at a time is deliberate. "Raise prices 10% and move them to Sale
 * and untag them" in one form is where a bulk tool does something nobody meant;
 * three small, previewed steps are each checkable.
 *
 * Built with createElement and textContent only — product names are shop data.
 */
import type { ProductCategory } from '../../core/models';
import { flattenTree } from '../../lib/commerce/category-tree';
import { minorUnits } from '../../lib/money-format';

interface Props { categories: ProductCategory[]; currency: string }
const { categories, currency } = Astro.props;
const options = flattenTree(categories, { collation: 'el' }).map(({ cat, depth }) => ({
  slug: cat.slug,
  label: `${'— '.repeat(depth)}${cat.name}`,
}));
---
<section id="bulk-bar" class="mb-4 rounded-lg border border-gray-200 bg-white p-4" aria-labelledby="bulk-title"
  data-minor={String(minorUnits(currency))} data-currency={currency}>
  <div class="flex flex-wrap items-end gap-3">
    <h2 id="bulk-title" class="sr-only">Change selected products</h2>
    <p class="text-sm text-gray-700 min-w-[9rem]" aria-live="polite"><strong id="bulk-count">0</strong> selected</p>

    <div>
      <label for="bulk-action" class="block text-xs font-medium text-gray-600 mb-1">Change</label>
      <select id="bulk-action" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
        <option value="">Choose a change…</option>
        <option value="status">Status</option>
        <option value="featured">Featured</option>
        <option value="addCategory">Add to category</option>
        <option value="removeCategory">Remove from category</option>
        <option value="addTag">Add tag</option>
        <option value="removeTag">Remove tag</option>
        <option value="price">Price</option>
        <option value="sale">Sale</option>
        <option value="stock">Stock</option>
      </select>
    </div>

    <div data-for="status" hidden>
      <label for="bulk-status" class="block text-xs font-medium text-gray-600 mb-1">New status</label>
      <select id="bulk-status" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
        <option value="active">Active</option><option value="draft">Draft</option><option value="archived">Archived</option>
      </select>
    </div>
    <div data-for="featured" hidden>
      <label for="bulk-featured" class="block text-xs font-medium text-gray-600 mb-1">Featured</label>
      <select id="bulk-featured" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
        <option value="true">Feature them</option><option value="false">Stop featuring them</option>
      </select>
    </div>
    <div data-for="addCategory removeCategory" hidden>
      <label for="bulk-category" class="block text-xs font-medium text-gray-600 mb-1">Category</label>
      <select id="bulk-category" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
        {options.map((o) => <option value={o.slug}>{o.label}</option>)}
      </select>
    </div>
    <div data-for="addTag removeTag" hidden>
      <label for="bulk-tag" class="block text-xs font-medium text-gray-600 mb-1">Tag</label>
      <input id="bulk-tag" maxlength="120" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" />
    </div>
    <div data-for="price" hidden class="flex items-end gap-2">
      <div>
        <label for="bulk-price-mode" class="block text-xs font-medium text-gray-600 mb-1">How</label>
        <select id="bulk-price-mode" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="percent">Change by %</option>
          <option value="amount">Change by amount ({currency})</option>
          <option value="set">Set to ({currency})</option>
        </select>
      </div>
      <div>
        <label for="bulk-price-value" class="block text-xs font-medium text-gray-600 mb-1">Value</label>
        <input id="bulk-price-value" inputmode="decimal" placeholder="e.g. 10 or -5" class="w-32 px-3 py-2 border border-gray-300 rounded-lg text-sm" aria-describedby="bulk-price-hint" />
      </div>
      <p id="bulk-price-hint" class="text-xs text-gray-500 max-w-[16rem]">Changes the regular price. Products on sale stay on sale.</p>
    </div>
    <div data-for="sale" hidden class="flex items-end gap-2">
      <div>
        <label for="bulk-sale-mode" class="block text-xs font-medium text-gray-600 mb-1">Sale</label>
        <select id="bulk-sale-mode" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="percent_off">% off the regular price</option>
          <option value="clear">End the sale</option>
        </select>
      </div>
      <div>
        <label for="bulk-sale-value" class="block text-xs font-medium text-gray-600 mb-1">Percent off</label>
        <input id="bulk-sale-value" inputmode="decimal" placeholder="e.g. 20" class="w-24 px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
    </div>
    <div data-for="stock" hidden>
      <label for="bulk-stock" class="block text-xs font-medium text-gray-600 mb-1">Stock count (empty = not tracked)</label>
      <input id="bulk-stock" inputmode="numeric" class="w-32 px-3 py-2 border border-gray-300 rounded-lg text-sm" />
    </div>

    <button id="bulk-preview" type="button" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium disabled:opacity-50" disabled>Preview</button>
  </div>
  <p id="bulk-error" class="mt-2 text-sm text-red-700" role="alert" hidden></p>
</section>

<dialog id="bulk-dialog" class="m-auto w-full max-w-2xl rounded-xl p-0 backdrop:bg-black/40" aria-labelledby="bulk-dialog-title">
  <div class="p-6">
    <h2 id="bulk-dialog-title" class="text-lg font-semibold text-gray-900">Review the change</h2>
    <p id="bulk-summary" class="mt-2 text-sm text-gray-700"></p>
    <ul id="bulk-list" class="mt-4 max-h-80 overflow-y-auto divide-y divide-gray-100 text-sm"></ul>
    <p id="bulk-result" class="mt-4 text-sm" role="status"></p>
    <div class="mt-6 flex justify-end gap-2">
      <button id="bulk-cancel" type="button" class="px-4 py-2 border border-gray-300 rounded-lg text-sm">Cancel</button>
      <button id="bulk-apply" type="button" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium disabled:opacity-50">Apply</button>
    </div>
  </div>
</dialog>

<script>
  import { api } from '../../lib/apiClient';

  const bar = document.getElementById('bulk-bar')!;
  const minor = Number(bar.dataset.minor) || 100;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const action = $<HTMLSelectElement>('bulk-action');
  const count = $('bulk-count');
  const previewBtn = $<HTMLButtonElement>('bulk-preview');
  const error = $('bulk-error');
  const dialog = $<HTMLDialogElement>('bulk-dialog');
  const applyBtn = $<HTMLButtonElement>('bulk-apply');

  const picks = () => [...document.querySelectorAll<HTMLInputElement>('.bulk-pick')];
  const selected = () => picks().filter((c) => c.checked).map((c) => c.value);

  function refresh() {
    const n = selected().length;
    count.textContent = String(n);
    previewBtn.disabled = n === 0 || !action.value;
    const all = document.getElementById('bulk-all') as HTMLInputElement | null;
    if (all) {
      const boxes = picks();
      all.checked = boxes.length > 0 && n === boxes.length;
      all.indeterminate = n > 0 && n < boxes.length;
    }
  }
  document.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (t.id === 'bulk-all') for (const c of picks()) c.checked = (t as HTMLInputElement).checked;
    if (t.id === 'bulk-all' || t.classList.contains('bulk-pick')) refresh();
  });
  action.addEventListener('change', () => {
    for (const el of bar.querySelectorAll<HTMLElement>('[data-for]')) {
      el.hidden = !(el.dataset.for ?? '').split(' ').includes(action.value);
    }
    refresh();
  });

  function showError(msg: string) { error.textContent = msg; error.hidden = !msg; }

  /**
   * A plain number, with at most one decimal separator (. or ,) and no
   * grouping. "1,000" is REFUSED rather than read: as one thousand or as one,
   * either guess sets a whole catalogue to the wrong price.
   */
  function plainNumber(text: string): number {
    const t = text.trim();
    if (!/^[-+]?\d+([.,]\d+)?$/.test(t)) return NaN;
    return Number(t.replace(',', '.'));
  }
  /** Decimal text in the shop currency → integer minor units, or NaN. */
  function toMinor(text: string): number {
    const n = plainNumber(text);
    return Number.isFinite(n) ? Math.round(n * minor) : NaN;
  }
  const numberOf = (id: string) => plainNumber($<HTMLInputElement>(id).value || '');

  /** The one operation the form describes, or a sentence saying what is missing. */
  function buildOps(): Record<string, unknown> | string {
    switch (action.value) {
      case 'status': return { status: $<HTMLSelectElement>('bulk-status').value };
      case 'featured': return { featured: $<HTMLSelectElement>('bulk-featured').value === 'true' };
      case 'addCategory': return { addCategories: [$<HTMLSelectElement>('bulk-category').value] };
      case 'removeCategory': return { removeCategories: [$<HTMLSelectElement>('bulk-category').value] };
      case 'addTag':
      case 'removeTag': {
        const t = $<HTMLInputElement>('bulk-tag').value.trim();
        if (!t) return 'Type the tag.';
        return action.value === 'addTag' ? { addTags: [t] } : { removeTags: [t] };
      }
      case 'price': {
        const mode = $<HTMLSelectElement>('bulk-price-mode').value;
        const raw = $<HTMLInputElement>('bulk-price-value').value;
        const value = mode === 'percent' ? numberOf('bulk-price-value') : toMinor(raw);
        if (!Number.isFinite(value)) return 'Type a plain number, like 10 or 12.50 — no thousands separators.';
        return { price: { mode, value } };
      }
      case 'sale': {
        const mode = $<HTMLSelectElement>('bulk-sale-mode').value;
        if (mode === 'clear') return { sale: { mode } };
        const value = numberOf('bulk-sale-value');
        if (!Number.isFinite(value)) return 'Type how many percent off.';
        return { sale: { mode, value } };
      }
      case 'stock': {
        const raw = $<HTMLInputElement>('bulk-stock').value.trim();
        const value = raw === '' ? null : Number(raw);
        if (value !== null && !Number.isInteger(value)) return 'Stock must be a whole number, or empty.';
        return { stock: value };
      }
      default: return 'Choose a change.';
    }
  }

  let pending: { ids: string[]; ops: Record<string, unknown> } | null = null;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text) n.textContent = text;
    return n;
  };

  previewBtn.addEventListener('click', async () => {
    showError('');
    const ops = buildOps();
    if (typeof ops === 'string') { showError(ops); return; }
    const ids = selected();
    previewBtn.disabled = true;
    const res = await api.post('/api/product-bulk', { ids, ops });
    previewBtn.disabled = false;
    if (!res.ok) { showError(res.error); return; }
    const d = res.data as { will_change: number; unchanged: number; skipped: number; not_found: string[]; products: { id: string; name: string; changes: string[]; skipped?: string }[] };
    pending = { ids, ops };
    $('bulk-summary').textContent =
      `${d.will_change} will change, ${d.unchanged} already match` +
      (d.skipped ? `, ${d.skipped} skipped` : '') + (d.not_found.length ? `, ${d.not_found.length} no longer exist` : '') + '.';
    const list = $('bulk-list');
    list.replaceChildren(...d.products.filter((p) => p.skipped || p.changes.length).map((p) => {
      const li = el('li', 'py-2');
      li.append(el('strong', '', p.name), el('span', p.skipped ? 'text-amber-800' : 'text-gray-600',
        p.skipped ? ` — skipped: ${p.skipped}` : ` — ${p.changes.join('; ')}`));
      return li;
    }));
    $('bulk-result').textContent = '';
    applyBtn.disabled = d.will_change === 0;
    applyBtn.textContent = d.will_change ? `Apply to ${d.will_change} product${d.will_change === 1 ? '' : 's'}` : 'Nothing to apply';
    dialog.showModal();
  });

  $('bulk-cancel').addEventListener('click', () => dialog.close());
  applyBtn.addEventListener('click', async () => {
    if (!pending) return;
    applyBtn.disabled = true;
    applyBtn.textContent = 'Applying…';
    const res = await api.post('/api/product-bulk', { ...pending, apply: true });
    if (!res.ok) {
      $('bulk-result').textContent = res.error;
      applyBtn.disabled = false;
      applyBtn.textContent = 'Try again';
      return;
    }
    const d = res.data as { updated: number; failed: { name: string; message: string }[] };
    $('bulk-result').textContent = `Updated ${d.updated}.` + (d.failed.length ? ` Not saved: ${d.failed.map((f) => `${f.name} (${f.message})`).join('; ')}.` : ' Reloading…');
    if (!d.failed.length) setTimeout(() => location.reload(), 700);
    else applyBtn.textContent = 'Done';
  });

  refresh();
</script>
