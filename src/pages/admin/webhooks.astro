---
import AdminLayout from '../../layouts/AdminLayout.astro';

const t = Astro.locals.t;
---

<AdminLayout title={t('admin.webhooks.title')}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-2xl font-semibold text-gray-900 mb-2">{t('admin.webhooks.title')}</h1>
    <p class="text-sm text-gray-500 mb-6">
      {t('admin.webhooks.intro')}
    </p>

    <div id="secret-box" class="hidden mb-6 p-4 rounded-lg bg-amber-50 border border-amber-200">
      <p class="text-sm font-medium text-amber-800 mb-2">{t('admin.webhooks.secretWarning')}</p>
      <div class="flex items-center gap-2">
        <code id="secret-value" class="flex-1 px-3 py-2 bg-white border border-amber-200 rounded text-sm break-all"></code>
        <button id="secret-copy" type="button" class="px-3 py-2 bg-amber-600 hover:bg-amber-700 text-white text-sm rounded">{t('admin.webhooks.copy')}</button>
      </div>
    </div>

    <form id="reg-form" class="bg-white border border-gray-200 rounded-xl p-6 mb-8 grid gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1" for="w-url">{t('admin.webhooks.urlLabel')}</label>
        <input id="w-url" name="url" type="url" required placeholder="https://hooks.example.com/astrobaas"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1" for="w-events">{t('admin.webhooks.eventsLabel')}</label>
        <input id="w-events" name="events" placeholder="post.*, content.created"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
        {/* The two <code> samples are literals from THIS file, not user input —
            the sentence has to wrap around them, and word order moves in German
            and Greek, so they are parameters rather than a split string. */}
        <p class="text-xs text-gray-400 mt-1" set:html={t('admin.webhooks.eventsHint', { all: '<code>*</code>', prefix: '<code>prefix.*</code>' })}></p>
      </div>
      <div>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium">{t('admin.webhooks.register')}</button>
        <span id="reg-error" class="ml-3 text-sm text-red-600"></span>
      </div>
    </form>

    <div class="bg-white border border-gray-200 rounded-xl overflow-x-auto mb-8">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-gray-500">
          <tr>
            <th class="px-4 py-3 text-left font-medium">{t('admin.webhooks.colUrl')}</th>
            <th class="px-4 py-3 text-left font-medium">{t('admin.webhooks.colEvents')}</th>
            <th class="px-4 py-3 text-left font-medium">{t('admin.webhooks.colActive')}</th>
            <th class="px-4 py-3 text-right font-medium">{t('admin.webhooks.colActions')}</th>
          </tr>
        </thead>
        <tbody id="hooks-body" class="divide-y divide-gray-100">
          <tr><td colspan="4" class="px-4 py-6 text-center text-gray-400">{t('admin.webhooks.loading')}</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-lg font-semibold text-gray-900 mb-3" id="deliveries-title">{t('admin.webhooks.deliveriesTitle')}</h2>
    <div class="bg-white border border-gray-200 rounded-xl overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-gray-500">
          <tr>
            <th class="px-4 py-3 text-left font-medium">{t('admin.webhooks.colEvent')}</th>
            <th class="px-4 py-3 text-left font-medium">{t('admin.webhooks.colStatus')}</th>
            <th class="px-4 py-3 text-left font-medium">{t('admin.webhooks.colAttempts')}</th>
            <th class="px-4 py-3 text-left font-medium">{t('admin.webhooks.colLastCode')}</th>
            <th class="px-4 py-3 text-left font-medium">{t('admin.webhooks.colWhen')}</th>
            <th class="px-4 py-3 text-right font-medium">{t('admin.webhooks.colActions')}</th>
          </tr>
        </thead>
        <tbody id="deliveries-body" class="divide-y divide-gray-100">
          <tr><td colspan="6" class="px-4 py-6 text-center text-gray-400">{t('admin.webhooks.loading')}</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    // @ts-nocheck — vanilla browser glue (DOM + fetch); not part of the typed API surface.
    const csrf = () => (window.__ASTROBAAS__?.csrf) || document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    const $ = (id) => document.getElementById(id);

    async function api(method, path, body) {
      const headers = { Accept: 'application/json' };
      if (body) headers['Content-Type'] = 'application/json';
      if (method !== 'GET') headers['X-CSRF-Token'] = csrf();
      const res = await fetch(path, { method, headers, body: body ? JSON.stringify(body) : undefined });
      const json = await res.json().catch(() => null);
      if (!res.ok || json?.success === false) throw new Error(json?.error?.message || `HTTP ${res.status}`);
      return json?.data;
    }

    /**
     * Delivery status: VALUE on the left, label key on the right.
     *
     * The stored status is what the colour branch and any future filter match
     * on, so it stays 'success' / 'failed' / 'pending' in every language and
     * only the displayed text is translated. An unknown status from a newer
     * server falls through to the raw value rather than to a blank cell.
     */
    const STATUS_LABEL_KEYS = {
      success: 'admin.webhooks.statusSuccess',
      failed: 'admin.webhooks.statusFailed',
      pending: 'admin.webhooks.statusPending',
    };
    const statusLabel = (s) => (STATUS_LABEL_KEYS[s] ? window.t(STATUS_LABEL_KEYS[s]) : String(s));

    /** An empty/error row, with the message set as TEXT rather than markup. */
    function messageRow(body, colspan, text, cls) {
      body.innerHTML = `<tr><td colspan="${colspan}" class="px-4 py-6 text-center ${cls}"></td></tr>`;
      body.querySelector('td').textContent = text;
    }

    function showSecret(s) {
      $('secret-value').textContent = s;
      $('secret-box').classList.remove('hidden');
      $('secret-box').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    $('secret-copy').addEventListener('click', () => navigator.clipboard?.writeText($('secret-value').textContent || ''));

    let activeFilter = '';

    function hookRow(w) {
      const tr = document.createElement('tr');
      const activeLabel = w.active ? window.t('admin.webhooks.yes') : window.t('admin.webhooks.no');
      for (const c of [w.url, (w.events || []).join(', '), activeLabel]) {
        const td = document.createElement('td');
        td.className = 'px-4 py-3 text-gray-700 break-all';
        td.textContent = c;
        tr.appendChild(td);
      }
      const actions = document.createElement('td');
      actions.className = 'px-4 py-3 text-right whitespace-nowrap';
      const view = document.createElement('button');
      view.textContent = window.t('admin.webhooks.viewDeliveries');
      view.className = 'text-blue-600 hover:underline mr-3';
      view.addEventListener('click', () => { activeFilter = w.id; loadDeliveries(); });
      const del = document.createElement('button');
      del.textContent = window.t('admin.webhooks.delete');
      del.className = 'text-red-600 hover:underline';
      del.addEventListener('click', () => doDelete(w.id, w.url));
      actions.append(view, del);
      tr.appendChild(actions);
      return tr;
    }

    function deliveryRow(d) {
      const tr = document.createElement('tr');
      const statusColor = d.status === 'success' ? 'text-green-700' : d.status === 'failed' ? 'text-red-700' : 'text-amber-700';
      const cells = [
        ['px-4 py-3 text-gray-700', d.event],
        [`px-4 py-3 font-medium ${statusColor}`, statusLabel(d.status)],
        ['px-4 py-3 text-gray-700', String(d.attempts)],
        ['px-4 py-3 text-gray-700', d.last_status != null ? String(d.last_status) : '—'],
        ['px-4 py-3 text-gray-500', new Date(d.created_at).toLocaleString()],
      ];
      for (const [cls, val] of cells) {
        const td = document.createElement('td');
        td.className = cls;
        td.textContent = val;
        tr.appendChild(td);
      }
      const actions = document.createElement('td');
      actions.className = 'px-4 py-3 text-right';
      const re = document.createElement('button');
      re.textContent = window.t('admin.webhooks.redeliver');
      re.className = 'text-blue-600 hover:underline';
      re.addEventListener('click', () => doRedeliver(d.id));
      actions.appendChild(re);
      tr.appendChild(actions);
      return tr;
    }

    async function loadHooks() {
      const body = $('hooks-body');
      try {
        const hooks = await api('GET', '/api/webhooks');
        body.innerHTML = '';
        if (!hooks.length) { messageRow(body, 4, window.t('admin.webhooks.empty'), 'text-gray-400'); return; }
        for (const w of hooks) body.appendChild(hookRow(w));
      } catch (e) {
        messageRow(body, 4, e.message, 'text-red-600');
      }
    }

    async function loadDeliveries() {
      const body = $('deliveries-body');
      $('deliveries-title').textContent = activeFilter
        ? window.t('admin.webhooks.deliveriesTitleFiltered')
        : window.t('admin.webhooks.deliveriesTitle');
      try {
        const q = activeFilter ? `?webhook=${encodeURIComponent(activeFilter)}&limit=50` : '?limit=50';
        const list = await api('GET', `/api/webhooks/deliveries${q}`);
        body.innerHTML = '';
        if (!list.length) { messageRow(body, 6, window.t('admin.webhooks.deliveriesEmpty'), 'text-gray-400'); return; }
        for (const d of list) body.appendChild(deliveryRow(d));
      } catch (e) {
        messageRow(body, 6, e.message, 'text-red-600');
      }
    }

    async function doDelete(id, url) {
      if (!confirm(window.t('admin.webhooks.deleteConfirm', { url }))) return;
      try { await api('DELETE', `/api/webhooks/${encodeURIComponent(id)}`); loadHooks(); }
      catch (e) { alert(e.message); }
    }
    async function doRedeliver(id) {
      try { await api('POST', `/api/webhooks/deliveries/${encodeURIComponent(id)}/redeliver`); loadDeliveries(); }
      catch (e) { alert(e.message); }
    }

    $('reg-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      $('reg-error').textContent = '';
      const f = e.target;
      const events = (f.events.value || '').split(',').map((s) => s.trim()).filter(Boolean);
      try {
        const w = await api('POST', '/api/webhooks', { url: f.url.value, events });
        showSecret(w.secret);
        f.reset();
        loadHooks();
      } catch (err) {
        $('reg-error').textContent = err.message;
      }
    });

    loadHooks();
    loadDeliveries();
  </script>
</AdminLayout>
