---
import AdminLayout from '../../layouts/AdminLayout.astro';
import InvoiceRecords from '../../components/admin/InvoiceRecords.astro';
import { invoiceAdminContext } from '../../lib/commerce/invoice-records';
import { summarisePrescription } from '../../core/models';
import { LocalDB } from '../../lib/localdb';
import { ORDER_STATUSES } from '../../lib/commerce-service';
import { refundedTotal, refundableRemaining } from '../../lib/payments/refunds';
import { getProvider } from '../../lib/payments/registry';
import { canOpenAdminPage } from '../../lib/admin-access';
import { canWriteCommerce } from '../../lib/auth';
import { formatMoney } from '../../lib/money-format';
import { touchSummary } from '../../lib/commerce/attribution';
import { formatAddressOneLine, addressesEqual } from '../../lib/commerce/address';
import { lineAddonsForDisplay } from '../../lib/commerce/line-addons-display';
import {
  countOrderTags, filterOrdersByTag, orderTagKey, orderTagsOf, orderTagColor,
  ORDER_TAG_MAX_PER_ORDER, ORDER_TAG_MAX_LENGTH, type OrderTagColor,
} from '../../lib/commerce/order-tags';
import {
  entitlementState, fileDownloadCount, isDownloadableProduct, orderGrantsDownloads,
  type EntitlementState,
} from '../../lib/commerce/download-entitlements';
import type { Product } from '../../core/models';

await LocalDB.init();
const user = Astro.locals.user;
// Same rule the middleware enforces, asked the same way — a second, hand-written
// role test here is how the two drift apart.
if (!canOpenAdminPage('/admin/orders', user?.role)) {
  return Astro.redirect('/admin');
}

/**
 * What this viewer may actually DO here, asked with the same predicates the API
 * asks — never re-derived from the role.
 *
 * A `manager` may read orders and customers but not write either, which is
 * deliberate. The page rendered an ENABLED status dropdown and an enabled
 * Refund button for them anyway, and both 403'd on use. A control that looks
 * live and silently fails is worse than no control: it teaches the operator
 * that the software is broken, and it hides the real rule behind a dead end.
 */
const canWrite = canWriteCommerce(user?.role);
const canRefund = user?.role === 'admin';
const t = Astro.locals.t;
// Which invoice issuer is in use, asked once for the whole list.
const invoiceContext = await invoiceAdminContext();

const allOrders = (await LocalDB.getOrders()).sort((a, b) => b.created_at.localeCompare(a.created_at));
// `?tag=` narrows the LIST only. The three figures above it stay the shop's
// totals: "open orders: 2" under a tag filter would read as the shop having two.
const tagFilter = Astro.url.searchParams.get('tag');
const orders = tagFilter ? filterOrdersByTag(allOrders, tagFilter) : allOrders;
const tagCounts = countOrderTags(allOrders);
// Which products sell files — read once, so a row can tell "no downloads yet"
// (an order that predates the feature) from "nothing to download".
const downloadableIds = new Set(
  ((await LocalDB.getProducts()) as Product[]).filter((p) => isDownloadableProduct(p)).map((p) => p.id),
);
const hasDownloadLines = (o: (typeof allOrders)[number]) =>
  (o.items ?? []).some((i) => !!i.product_id && downloadableIds.has(i.product_id));
const dlStateClass: Record<EntitlementState, string> = {
  active: 'bg-green-100 text-green-800',
  expired: 'bg-gray-200 text-gray-700',
  exhausted: 'bg-amber-100 text-amber-800',
  revoked: 'bg-red-100 text-red-800',
  inactive: 'bg-gray-100 text-gray-600',
};
const dlReasonLabel: Record<string, string> = {
  refunded: t('admin.orders.downloadsReasonRefunded'),
  cancelled: t('admin.orders.downloadsReasonCancelled'),
  staff: t('admin.orders.downloadsReasonStaff'),
  erased: t('admin.orders.downloadsReasonErased'),
};
const dlStateLabel: Record<EntitlementState, string> = {
  active: t('admin.orders.downloadsStateActive'),
  expired: t('admin.orders.downloadsStateExpired'),
  exhausted: t('admin.orders.downloadsStateExhausted'),
  revoked: t('admin.orders.downloadsStateRevoked'),
  inactive: t('admin.orders.downloadsStateInactive'),
};
// Classes are spelled out so Tailwind sees them; the SERVER picks the colour
// name from the tag (orderTagColor), so there is no colour input to abuse.
const tagClass: Record<OrderTagColor, string> = {
  red: 'bg-red-100 text-red-800',
  orange: 'bg-orange-100 text-orange-800',
  amber: 'bg-amber-100 text-amber-800',
  green: 'bg-green-100 text-green-800',
  teal: 'bg-teal-100 text-teal-800',
  blue: 'bg-blue-100 text-blue-800',
  indigo: 'bg-indigo-100 text-indigo-800',
  purple: 'bg-purple-100 text-purple-800',
  pink: 'bg-pink-100 text-pink-800',
  gray: 'bg-gray-200 text-gray-700',
};
// The hardcoded el-GR here was one of five, and disagreed with the sale
// email's formatMoney — the screen and the receipt stated the same total two
// ways. The locale now follows the staff member reading it.
const adminLocale = Astro.locals.uiLocale ?? undefined;
const money = (cents: number, cur = 'EUR') => formatMoney(cents, { currency: cur, locale: adminLocale });
const open = allOrders.filter((o) => o.status === 'pending' || o.status === 'processing').length;
const revenue = allOrders.filter((o) => o.status === 'completed').reduce((n, o) => n + o.total_cents, 0);
// Payment status is tracked separately from fulfilment: "processing" says we
// are working on it, "paid" says the money arrived. Showing only the first is
// how orders get shipped unpaid, so both appear on every row.
const paymentColor: Record<string, string> = {
  paid: 'bg-green-100 text-green-800',
  pending: 'bg-amber-100 text-amber-800',
  failed: 'bg-red-100 text-red-800',
  refunded: 'bg-purple-100 text-purple-800',
  unpaid: 'bg-gray-100 text-gray-600',
};
// Labels, keyed by the payment_status VALUE. The keys stay English because they
// are the API's vocabulary; only the right-hand side is shown to anyone.
const paymentLabel: Record<string, string> = {
  paid: t('admin.orders.paymentPaid'),
  pending: t('admin.orders.paymentPending'),
  failed: t('admin.orders.paymentFailed'),
  refunded: t('admin.orders.paymentRefunded'),
  unpaid: t('admin.orders.paymentUnpaid'),
};
// A refund button is offered only when it can actually work: the order is paid
// through a provider that implements refunds, and something is still
// outstanding. Showing one that 501s is worse than showing none.
const refundInfo = (o: (typeof orders)[number]) => {
  const remaining = refundableRemaining(o);
  const provider = o.payment_provider ? getProvider(o.payment_provider) : undefined;
  return {
    refunded: refundedTotal(o),
    remaining,
    supported: typeof provider?.refund === 'function',
    providerLabel: provider?.label ?? o.payment_method ?? 'manual',
    canRefund: (o.payment_status ?? 'unpaid') === 'paid' && remaining > 0 && typeof provider?.refund === 'function',
  };
};

// Same split for fulfilment status: `ORDER_STATUSES` supplies the values the
// select posts, this map supplies what the operator reads. A status with no
// label falls back to its own value rather than to an empty badge.
const statusLabel: Record<string, string> = {
  pending: t('admin.orders.statusPending'),
  processing: t('admin.orders.statusProcessing'),
  'on-hold': t('admin.orders.statusOnHold'),
  completed: t('admin.orders.statusCompleted'),
  cancelled: t('admin.orders.statusCancelled'),
  refunded: t('admin.orders.statusRefunded'),
  failed: t('admin.orders.statusFailed'),
};

// Timeline (order-timeline.ts). Labels are looked up by the event CODE the API
// returns; spelled out with literal keys so the i18n guard sees every one. A
// code with no label (a plugin's `bulk.*`) falls back to the code itself.
const timelineLabels: Record<string, string> = {
  'order.placed': t('admin.orders.tlOrderPlaced'),
  'order.abandoned': t('admin.orders.tlOrderAbandoned'),
  'order.hold_expired': t('admin.orders.tlOrderHoldExpired'),
  'status.changed': t('admin.orders.tlStatusChanged'),
  'payment.started': t('admin.orders.tlPaymentStarted'),
  'payment.captured': t('admin.orders.tlPaymentCaptured'),
  'payment.failed': t('admin.orders.tlPaymentFailed'),
  'payment.declined': t('admin.orders.tlPaymentDeclined'),
  'payment.refunded': t('admin.orders.tlPaymentRefunded'),
  'payment.needs_refund': t('admin.orders.tlPaymentNeedsRefund'),
  'refund.issued': t('admin.orders.tlRefundIssued'),
  'shipment.shipped': t('admin.orders.tlShipmentShipped'),
  'shipment.tracking_updated': t('admin.orders.tlTrackingUpdated'),
  'note.staff_updated': t('admin.orders.tlNoteStaffUpdated'),
  'note.staff_cleared': t('admin.orders.tlNoteStaffCleared'),
  'note.customer_edited': t('admin.orders.tlNoteCustomerEdited'),
  'note.comment': t('admin.orders.tlNoteComment'),
  'tags.changed': t('admin.orders.tlTagsChanged'),
  'tax.override': t('admin.orders.tlTaxOverride'),
  'email.recovery_sent': t('admin.orders.tlRecoverySent'),
  'consent.terms_accepted': t('admin.orders.tlTermsAccepted'),
  'consent.privacy_accepted': t('admin.orders.tlPrivacyAccepted'),
};
const timelineUi = {
  actors: {
    system: t('admin.orders.tlActorSystem'),
    provider: t('admin.orders.tlActorProvider'),
    customer: t('admin.orders.tlActorCustomer'),
  },
  loading: t('admin.orders.tlLoading'),
  empty: t('admin.orders.tlEmpty'),
  failed: t('admin.orders.tlFailed'),
  more: t('admin.orders.tlMore'),
  by: t('admin.orders.tlBy'),
  declinedTimes: t('admin.orders.tlDeclinedTimes'),
  commentFailed: t('admin.orders.tlCommentFailed'),
};

const statusColor: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-800',
  processing: 'bg-blue-100 text-blue-800',
  'on-hold': 'bg-gray-100 text-gray-700',
  completed: 'bg-green-100 text-green-800',
  cancelled: 'bg-gray-200 text-gray-600',
  refunded: 'bg-purple-100 text-purple-800',
  failed: 'bg-red-100 text-red-700',
};
---

<AdminLayout title={t('admin.orders.title')}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" id="orders-root" data-tl-labels={JSON.stringify(timelineLabels)} data-tl-ui={JSON.stringify(timelineUi)} data-status-labels={JSON.stringify(statusLabel)} data-locale={adminLocale ?? ''}>
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">{t('admin.orders.title')}</h1>
      <p class="text-gray-600 mt-2">{t('admin.orders.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="text-2xl font-bold text-gray-900">{allOrders.length}</div>
        <div class="text-sm text-gray-600">{t('admin.orders.statTotal')}</div>
      </div>
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="text-2xl font-bold text-blue-600">{open}</div>
        <div class="text-sm text-gray-600">{t('admin.orders.statOpen')}</div>
      </div>
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="text-2xl font-bold text-green-600">{money(revenue)}</div>
        <div class="text-sm text-gray-600">{t('admin.orders.statRevenue')}</div>
      </div>
    </div>

    {(tagCounts.length > 0 || tagFilter) && (
      <div id="order-tags-root" class="mb-4" data-palette={JSON.stringify(tagClass)} data-max={ORDER_TAG_MAX_PER_ORDER}>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm text-gray-600">{t('admin.orders.tagsFilter')}</span>
          <a href="/admin/orders"
            class:list={['px-2 py-0.5 rounded-full text-xs border', !tagFilter ? 'bg-gray-800 text-white border-gray-800' : 'border-gray-300 text-gray-700 hover:bg-gray-50']}>
            {t('admin.orders.tagsAll')}: {allOrders.length}
          </a>
          {tagCounts.map((c) => (
            <a href={`/admin/orders?tag=${encodeURIComponent(c.tag)}`}
              class:list={['px-2 py-0.5 rounded-full text-xs', tagClass[c.color],
                tagFilter && orderTagKey(c.tag) === orderTagKey(tagFilter.trim()) ? 'ring-2 ring-offset-1 ring-gray-700' : '']}>
              {c.tag}: {c.count}
            </a>
          ))}
        </div>
        {tagFilter && (
          <p class="text-sm text-gray-600 mt-2">
            {t('admin.orders.tagsShowing', { tag: tagFilter })} ·
            <a href="/admin/orders" class="text-blue-600 hover:underline">{t('admin.orders.tagsClear')}</a>
          </p>
        )}
        <p class="text-xs text-gray-400 mt-1">{t('admin.orders.tagsPrivate')}</p>
        {canWrite && tagCounts.length > 0 && (
          <details class="mt-2 text-sm">
            <summary class="cursor-pointer text-gray-600">{t('admin.orders.tagsManage')}</summary>
            <ul class="mt-2 space-y-1">
              {tagCounts.map((c) => (
                <li class="flex items-center gap-2">
                  <span class={`px-2 py-0.5 rounded-full text-xs ${tagClass[c.color]}`}>{c.tag}</span>
                  <span class="text-xs text-gray-500">{c.count}</span>
                  <button type="button" class="tag-rename text-xs text-blue-700 underline" data-tag={c.tag} data-count={c.count}>{t('admin.orders.tagRename')}</button>
                  <button type="button" class="tag-delete text-xs text-red-700 underline" data-tag={c.tag} data-count={c.count}>{t('admin.orders.tagDelete')}</button>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )}
    <datalist id="order-tag-suggestions">
      {tagCounts.map((c) => <option value={c.tag}>{c.count}</option>)}
    </datalist>

    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      {orders.length === 0 ? (
        <p class="p-6 text-sm text-gray-500">{tagFilter ? t('admin.orders.tagsNone') : t('admin.orders.empty')}</p>
      ) : (
        <ul class="divide-y divide-gray-200">
          {orders.map((o) => (
            <li class="p-6">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <div class="min-w-0">
                  <div class="flex items-center gap-3 flex-wrap">
                    <span class="font-semibold text-gray-900">{o.number}</span>
                    <span class={`px-2 py-0.5 rounded-full text-xs ${statusColor[o.status] ?? 'bg-gray-100'}`}>{statusLabel[o.status] ?? o.status}</span>
                    <span class={`px-2 py-0.5 rounded-full text-xs ${paymentColor[o.payment_status ?? 'unpaid'] ?? 'bg-gray-100'}`}>
                      {paymentLabel[o.payment_status ?? 'unpaid'] ?? o.payment_status}
                    </span>
                    {o.payment_method && (
                      <span class="px-2 py-0.5 rounded-full text-xs bg-indigo-100 text-indigo-800">
                        {o.payment_method === 'bank-transfer' ? t('admin.orders.methodBankTransfer') : o.payment_method}
                      </span>
                    )}
                    <span class="text-sm text-gray-500">{new Date(o.created_at).toLocaleString()}</span>
                  </div>
                  {/*
                    What the payment path and checkout flagged. There is no
                    attention feed on this screen yet, so the flags are shown on
                    the row itself — the one place staff already look.
                    `needs_refund` first and loudest: money arrived for an order
                    that will not ship.
                  */}
                  {(o.needs_refund || o.risk_held || o.risk_flagged || (o.payment_declines ?? 0) > 0
                    || (o.status === 'cancelled' && o.cancelled_reason === 'hold-expired')) && (
                    <div class="flex items-center gap-2 flex-wrap mt-1">
                      {o.needs_refund && (
                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-600 text-white">{t('admin.orders.needsRefund')}</span>
                      )}
                      {o.risk_held && (
                        <span class="px-2 py-0.5 rounded-full text-xs bg-orange-100 text-orange-800">{t('admin.orders.riskHeld')}</span>
                      )}
                      {o.risk_flagged && !o.risk_held && (
                        <span class="px-2 py-0.5 rounded-full text-xs bg-orange-50 text-orange-700" title={(o.risk_reasons ?? []).join('\n')}>
                          {t('admin.orders.riskFlagged')}
                        </span>
                      )}
                      {(o.payment_declines ?? 0) > 0 && (
                        <span class="px-2 py-0.5 rounded-full text-xs bg-red-50 text-red-700">
                          {t('admin.orders.declines', { count: String(o.payment_declines) })}
                        </span>
                      )}
                      {/* Only on a CANCELLED order: the reason describes that
                          cancellation, and an order reopened before S4.18 may
                          still carry it. */}
                      {o.status === 'cancelled' && o.cancelled_reason === 'hold-expired' && (
                        <span class="px-2 py-0.5 rounded-full text-xs bg-gray-100 text-gray-600">{t('admin.orders.holdExpired')}</span>
                      )}
                    </div>
                  )}
                  {o.risk_held && (o.risk_reasons ?? []).length > 0 && (
                    <ul class="text-xs text-orange-800 mt-1 list-disc list-inside">
                      {(o.risk_reasons ?? []).map((reason) => <li>{reason}</li>)}
                    </ul>
                  )}
                  <div class="text-sm text-gray-700 mt-1">
                    {o.name || '—'} · <a href={`mailto:${o.email}`} class="text-blue-600 hover:underline">{o.email}</a>
                    {o.phone && <span> · {o.phone}</span>}
                  </div>
                  {/*
                    The STRUCTURED address when there is one, the legacy line
                    when there is not.

                    Not both: on a new order the flat string is a rendering OF
                    the structured fields, so showing the two together prints
                    the same address twice and invites staff to wonder which is
                    authoritative. On an old order the line is all there is, and
                    saying so honestly beats an empty address block.
                  */}
                  {o.shipping_address ? (
                    <div class="text-sm text-gray-500 mt-0.5">
                      {o.shipping_address.name && <div>{o.shipping_address.name}</div>}
                      {o.shipping_address.company && <div>{o.shipping_address.company}</div>}
                      <div>{formatAddressOneLine(o.shipping_address, adminLocale)}</div>
                      {o.shipping_address.phone && <div>{o.shipping_address.phone}</div>}
                      {o.shipping_address.tax_id && <div>ΑΦΜ / VAT: {o.shipping_address.tax_id}</div>}
                      {/* Only when it genuinely differs — repeating an identical
                          billing block is noise on every order that has one. */}
                      {o.billing_address && !addressesEqual(o.billing_address, o.shipping_address) && (
                        <div class="mt-1 pt-1 border-t border-gray-200">
                          <span class="text-xs uppercase tracking-wide text-gray-400">Billing</span>
                          {o.billing_address.name && <div>{o.billing_address.name}</div>}
                          {o.billing_address.company && <div>{o.billing_address.company}</div>}
                          <div>{formatAddressOneLine(o.billing_address, adminLocale)}</div>
                          {o.billing_address.tax_id && <div>ΑΦΜ / VAT: {o.billing_address.tax_id}</div>}
                        </div>
                      )}
                    </div>
                  ) : (
                    o.address && <div class="text-sm text-gray-500 mt-0.5">{o.address}</div>
                  )}
                  <ul class="mt-2 text-sm text-gray-600 list-disc list-inside">
                    {o.items.map((i, lineIndex) => (
                      <li>
                        {i.qty} × {i.name} — {money(i.total_cents, o.currency)}
                        {/* Priced add-ons, frozen at purchase and already
                            inside the line total. The same reader as the
                            receipt, so staff and customer see one list. */}
                        {lineAddonsForDisplay(i, (c) => money(c, o.currency)).map((a) => (
                          <span class="order-line-addon block ml-5 mt-0.5 text-xs text-gray-500">+ {a.label} — {a.amount}</span>
                        ))}
                        {i.prescription && (
                          <span class="block ml-5 mt-0.5 font-mono text-xs text-indigo-700">
                            {t('admin.orders.prescription')} {summarisePrescription(i.prescription)}
                            {i.prescription.issued_by && (
                              <span class="text-gray-400"> · {i.prescription.issued_by}</span>
                            )}
                            {/* The one control that removes health data this
                                system deliberately KEEPS through a subject
                                erasure — so it is a deliberate act by the
                                optician, on the order in front of them, and it
                                is audited. There is no bulk version. */}
                            {canWrite && (
                              <button
                                class="delete-rx ml-2 font-sans text-xs text-gray-400 hover:text-red-600 underline"
                                data-order={o.id}
                                data-line={lineIndex}
                                data-number={o.number}
                              >{t('admin.orders.prescriptionDelete')}</button>
                            )}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                  {o.note && <div class="text-xs text-gray-400 mt-2">{t('admin.orders.note', { note: o.note })}</div>}
                  {/* What the buyer ANSWERED at checkout. Nothing at all when the
                      order has no record (older order, import, staff-placed):
                      absent is "unknown", and printing "not accepted" there
                      would assert something nobody observed. */}
                  {(o.terms_accepted !== undefined || o.privacy_accepted === true) && (
                    <div class="text-xs text-gray-500 mt-1">
                      {o.terms_accepted === true && (
                        <span>{t('admin.orders.termsAccepted', { date: o.terms_accepted_at ? new Date(o.terms_accepted_at).toLocaleString() : '—' })}</span>
                      )}
                      {o.terms_accepted === false && <span>{t('admin.orders.termsDeclined')}</span>}
                      {o.privacy_accepted === true && (
                        <span>{o.terms_accepted !== undefined ? ' · ' : ''}{t('admin.orders.privacyAccepted')}</span>
                      )}
                    </div>
                  )}

                  {/* Campaign attribution. Present only when the customer granted
                      marketing consent and arrived through a campaign link;
                      nothing is printed otherwise, because "no campaign" and
                      "no consent" cannot be told apart and neither is a fact
                      about the order. Text only, escaped by the template. */}
                  {o.attribution && (
                    <div class="order-attribution text-xs text-gray-600 mt-2" data-attribution={o.id}>
                      <div class="font-medium text-gray-700">{t('admin.orders.attribution')}</div>
                      <dl class="mt-0.5 space-y-0.5">
                        {(['first', 'last'] as const).map((which) => {
                          const s = touchSummary(o.attribution![which]);
                          return (
                            <div class="flex flex-wrap gap-x-2">
                              <dt class="text-gray-500">{t(which === 'first' ? 'admin.orders.attributionFirst' : 'admin.orders.attributionLast')}</dt>
                              <dd class="min-w-0 break-all">
                                <span class="text-gray-800">{s.headline}</span>
                                <span class="text-gray-400"> · {new Date(s.at).toLocaleString()}</span>
                                {s.details.length > 0 && <span class="text-gray-500"> · {s.details.join(' · ')}</span>}
                              </dd>
                            </div>
                          );
                        })}
                      </dl>
                    </div>
                  )}

                  {/* Staff tags. Text only — `{tag}` is escaped by the template and the
                      client script below builds badges with textContent. */}
                  <div class="order-tags mt-3 flex flex-wrap items-center gap-1" data-order={o.id} data-number={o.number}>
                    {orderTagsOf(o).map((tag) => (
                      <span class={`order-tag inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs ${tagClass[orderTagColor(tag)]}`}>
                        <a href={`/admin/orders?tag=${encodeURIComponent(tag)}`} class="hover:underline">{tag}</a>
                        {canWrite && (
                          <button type="button" class="tag-remove leading-none opacity-60 hover:opacity-100"
                            data-tag={tag} aria-label={t('admin.orders.tagRemove', { tag })}>×</button>
                        )}
                      </span>
                    ))}
                    {canWrite && (
                      <>
                        <input
                          class="tag-input w-36 px-2 py-0.5 text-xs border border-gray-300 rounded"
                          list="order-tag-suggestions"
                          maxlength={ORDER_TAG_MAX_LENGTH}
                          placeholder={t('admin.orders.tagInputPlaceholder')}
                          aria-label={t('admin.orders.tagInputLabel', { number: String(o.number) })} />
                        <button type="button" class="tag-add text-xs px-2 py-0.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50">
                          {t('admin.orders.tagAdd')}
                        </button>
                      </>
                    )}
                  </div>

                  {/* The order's timeline: loaded when it is opened, so a list of
                      fifty orders makes no timeline requests until someone asks.
                      Built with textContent client-side (notes are free text). */}
                  <details class="order-timeline mt-3" data-order={o.id} data-number={o.number} data-currency={o.currency}>
                    <summary class="cursor-pointer text-xs text-gray-600">{t('admin.orders.tlTitle')}</summary>
                    <div class="mt-2 border border-gray-200 rounded-lg p-3 bg-gray-50">
                      <div class="flex flex-wrap items-center gap-2 mb-2">
                        <label class="text-xs text-gray-600" for={`tl-filter-${o.id}`}>{t('admin.orders.tlFilter')}</label>
                        <select id={`tl-filter-${o.id}`} class="tl-filter text-xs border border-gray-300 rounded px-1 py-0.5">
                          <option value="">{t('admin.orders.tlFilterAll')}</option>
                          <option value="status">{t('admin.orders.tlFilterStatus')}</option>
                          <option value="payments">{t('admin.orders.tlFilterPayments')}</option>
                          <option value="shipments">{t('admin.orders.tlFilterShipments')}</option>
                          <option value="notes">{t('admin.orders.tlFilterNotes')}</option>
                          <option value="other">{t('admin.orders.tlFilterOther')}</option>
                        </select>
                        <a class="tl-csv text-xs text-blue-700 underline"
                          href={`/api/orders/${encodeURIComponent(o.id)}/timeline?format=csv`}>{t('admin.orders.tlExport')}</a>
                      </div>
                      <ol class="tl-list space-y-2 text-sm" aria-live="polite"></ol>
                      <p class="tl-status text-xs text-gray-500 mt-1"></p>
                      <button type="button" class="tl-more hidden text-xs text-blue-700 underline mt-1">{t('admin.orders.tlMore')}</button>
                      {canWrite && (
                        <div class="mt-2 flex flex-wrap items-start gap-2">
                          <textarea class="tl-comment flex-1 min-w-[12rem] px-2 py-1 text-xs border border-gray-300 rounded" rows="2"
                            maxlength="1000" placeholder={t('admin.orders.tlCommentPlaceholder')}
                            aria-label={t('admin.orders.tlCommentLabel', { number: String(o.number) })}></textarea>
                          <button type="button" class="tl-add text-xs px-2 py-1 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100">{t('admin.orders.tlCommentAdd')}</button>
                        </div>
                      )}
                    </div>
                  </details>

                  {/* Fulfilment. Beside the status, never inside it: dispatch is
                      not a payment state, and an order can be processing and
                      already posted. The email sends once, on the first save. */}
                  {canWrite && (
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      <input
                        class="ship-carrier w-32 px-2 py-1 text-xs border border-gray-300 rounded"
                        data-id={o.id}
                        value={o.tracking_carrier ?? ''}
                        placeholder={t('admin.orders.trackingCarrier')} />
                      <input
                        class="ship-number w-44 px-2 py-1 text-xs font-mono border border-gray-300 rounded"
                        data-id={o.id}
                        value={o.tracking_number ?? ''}
                        placeholder={t('admin.orders.trackingNumber')} />
                      <button
                        class="ship-save text-xs px-3 py-1 rounded-lg border border-blue-300 text-blue-700 hover:bg-blue-50"
                        data-id={o.id}
                      >{o.shipped_at ? t('admin.orders.trackingUpdate') : t('admin.orders.trackingSend')}</button>
                      {o.shipped_at && (
                        <span class="text-xs text-green-700">
                          {t('admin.orders.shippedOn', { date: new Date(o.shipped_at).toLocaleDateString() })}
                        </span>
                      )}
                    </div>
                  )}

                  <InvoiceRecords order={o} canWrite={canRefund} money={money} context={invoiceContext} />

                  {/* The SHOP's note. `note` above is the customer's words and is
                      cleared by an erasure; this is the shop's own record. */}
                  {canWrite && (
                    <textarea
                      class="staff-note mt-2 w-full px-2 py-1 text-xs border border-gray-200 rounded bg-amber-50"
                      data-id={o.id}
                      rows="2"
                      placeholder={t('admin.orders.staffNotePlaceholder')}>{o.staff_note ?? ''}</textarea>
                  )}

                  {/* Download entitlements: what the buyer may download, how
                      often they have, and from where. Staff only — the IP log
                      is personal data and is never shown to the buyer. */}
                  {((o.entitlements?.length ?? 0) > 0 || hasDownloadLines(o)) && (
                    <section class="order-downloads mt-3 rounded-lg border border-gray-200 p-3 text-xs" data-order={o.id}
                      aria-label={`${t('admin.orders.downloadsTitle')} ${o.number}`}>
                      <h3 class="text-sm font-semibold text-gray-800 mb-2">{t('admin.orders.downloadsTitle')}</h3>
                      {(o.entitlements?.length ?? 0) === 0 && (
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="text-gray-500">{t('admin.orders.downloadsNone')}</span>
                          {canWrite && orderGrantsDownloads(o) && (
                            <button type="button" class="dl-action px-2 py-0.5 rounded border border-blue-300 text-blue-700 hover:bg-blue-50"
                              data-action="grant">{t('admin.orders.downloadsGrant')}</button>
                          )}
                        </div>
                      )}
                      <ul class="space-y-3">
                        {(o.entitlements ?? []).map((e) => {
                          const state = entitlementState(e, o);
                          return (
                            <li class="entitlement" data-entitlement={e.id}>
                              <div class="flex flex-wrap items-center gap-2">
                                <span class="font-medium text-gray-900">{e.name}</span>
                                <span class={`px-2 py-0.5 rounded-full ${dlStateClass[state]}`}>{dlStateLabel[state]}</span>
                                <span class="text-gray-600">
                                  {e.download_limit === null
                                    ? t('admin.orders.downloadsCountUnlimited', { count: e.download_count })
                                    : t('admin.orders.downloadsCount', { count: e.download_count, limit: e.download_limit })}
                                </span>
                                <span class="text-gray-500">
                                  {e.expires_at
                                    ? t('admin.orders.downloadsExpires', { date: new Date(e.expires_at).toLocaleDateString(adminLocale) })
                                    : t('admin.orders.downloadsNoExpiry')}
                                </span>
                                {e.revoked_reason && (
                                  <span class="text-red-700">{t('admin.orders.downloadsRevokedReason', { reason: dlReasonLabel[e.revoked_reason] ?? e.revoked_reason })}</span>
                                )}
                                {canWrite && (
                                  <span class="flex gap-1">
                                    {e.revoked_at ? (
                                      <button type="button" class="dl-action px-2 py-0.5 rounded border border-gray-300 hover:bg-gray-50"
                                        data-action="restore" data-entitlement={e.id}>{t('admin.orders.downloadsRestore')}</button>
                                    ) : (
                                      <button type="button" class="dl-action px-2 py-0.5 rounded border border-red-300 text-red-700 hover:bg-red-50"
                                        data-action="revoke" data-entitlement={e.id}>{t('admin.orders.downloadsRevoke')}</button>
                                    )}
                                    {e.download_count > 0 && (
                                      <button type="button" class="dl-action px-2 py-0.5 rounded border border-gray-300 hover:bg-gray-50"
                                        data-action="reset" data-entitlement={e.id}>{t('admin.orders.downloadsReset')}</button>
                                    )}
                                  </span>
                                )}
                              </div>
                              <p class="mt-1 text-gray-500">
                                {e.files.map((f, i) => `${f.name} (${fileDownloadCount(e, i)}${e.download_limit === null ? '' : `/${e.download_limit}`})`).join(' · ')}
                              </p>
                              <details class="mt-1">
                                <summary class="cursor-pointer text-gray-600">{t('admin.orders.downloadsLogTitle')} ({e.log?.length ?? 0})</summary>
                                {(e.log?.length ?? 0) === 0 ? (
                                  <p class="mt-1 text-gray-500">{t('admin.orders.downloadsLogEmpty')}</p>
                                ) : (
                                  <table class="mt-1 w-full">
                                    <tbody>
                                      {(e.log ?? []).slice().reverse().map((entry) => (
                                        <tr class="border-t border-gray-100">
                                          <td class="py-0.5 pr-2 tabular-nums">{new Date(entry.at).toLocaleString(adminLocale)}</td>
                                          <td class="py-0.5 pr-2">{entry.file}</td>
                                          <td class="py-0.5 font-mono text-gray-500">{entry.ip ?? '—'}</td>
                                        </tr>
                                      ))}
                                    </tbody>
                                  </table>
                                )}
                              </details>
                            </li>
                          );
                        })}
                      </ul>
                    </section>
                  )}
                </div>
                <div class="flex flex-col items-end gap-2 shrink-0">
                  <div class="text-lg font-bold text-gray-900">{money(o.total_cents, o.currency)}</div>
                  {refundInfo(o).refunded > 0 && (
                    <div class="text-xs text-purple-700">
                      {t('admin.orders.refundedAmount', { amount: money(refundInfo(o).refunded, o.currency) })}
                      {refundInfo(o).remaining > 0 && <span> · {t('admin.orders.refundRemaining', { amount: money(refundInfo(o).remaining, o.currency) })}</span>}
                    </div>
                  )}
                  <select
                    class:list={['status-select text-sm border rounded-lg px-2 py-1',
                      canWrite ? 'border-gray-300' : 'border-gray-200 bg-gray-100 text-gray-500 cursor-not-allowed']}
                    data-id={o.id}
                    data-current={o.status}
                    aria-label={t('admin.orders.statusOf', { number: String(o.number) })}
                    disabled={!canWrite}
                    title={canWrite ? undefined : t('admin.orders.statusLocked')}
                  >
                    {ORDER_STATUSES.map((s) => (
                      <option value={s} selected={s === o.status}>{statusLabel[s] ?? s}</option>
                    ))}
                  </select>
                  {refundInfo(o).canRefund && canRefund && (
                    <button
                      class="refund-btn text-sm px-3 py-1 rounded-lg border border-purple-300 text-purple-700 hover:bg-purple-50"
                      data-id={o.id}
                      data-number={o.number}
                      data-remaining={refundInfo(o).remaining}
                      data-currency={o.currency}
                      data-provider={refundInfo(o).providerLabel}
                    >
                      {t('admin.orders.refund')}
                    </button>
                  )}
                  {(o.payment_status ?? 'unpaid') === 'paid' && !refundInfo(o).supported && (
                    <span class="text-xs text-gray-400">
                      {t('admin.orders.refundInProviderDashboard', { provider: refundInfo(o).providerLabel })}
                    </span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</AdminLayout>

<script>
  // @ts-nocheck
  import { api } from '../../lib/apiClient';
  document.addEventListener('change', async (e) => {
    const sel = e.target.closest('.status-select');
    if (!sel) return;
    const res = await api.put(`/api/orders/${sel.dataset.id}`, { status: sel.value });
    if (res.ok) location.reload();
    else {
      alert(res.error || window.t('admin.orders.updateFailed'));
      sel.value = sel.dataset.current;
    }
  });

  // Download entitlements: revoke, restore, reset the count, or grant what a
  // paid order is owed. The server decides; the page reloads to show it.
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.dl-action');
    if (!btn) return;
    const box = btn.closest('.order-downloads');
    const action = btn.dataset.action;
    if (action === 'revoke' && !confirm(window.t('admin.orders.downloadsRevokeConfirm'))) return;
    if (action === 'reset' && !confirm(window.t('admin.orders.downloadsResetConfirm'))) return;
    btn.disabled = true;
    const res = await api.post(`/api/orders/${encodeURIComponent(box.dataset.order)}/downloads`,
      { action, ...(btn.dataset.entitlement ? { entitlement_id: btn.dataset.entitlement } : {}) });
    if (res.ok) location.reload();
    else {
      alert(res.error || window.t('admin.orders.downloadsFailed'));
      btn.disabled = false;
    }
  });

  // Refunds move money out of the business, so the flow is deliberately
  // deliberate: the operator types the amount, sees exactly what will be sent
  // and to whom, and confirms. No one-click "refund everything".
  // Saved on blur rather than with a button: one Save per order row is clutter,
  // and a note nobody pressed Save on is a note that was lost.
  document.addEventListener('focusout', async (e) => {
    const box = e.target.closest?.('.staff-note');
    if (!box || box.value === box.defaultValue) return;
    const res = await api.put(`/api/orders/${encodeURIComponent(box.dataset.id)}`, {
      staff_note: box.value,
    });
    if (res.ok) box.defaultValue = box.value;
    else alert(res.error || window.t('admin.orders.staffNoteFailed'));
  });

  // ---- Staff tags. Everything below builds nodes with textContent: a tag is
  // free text somebody typed, so it is never concatenated into markup.
  const tagRoot = document.getElementById('order-tags-root');
  const palette = (() => { try { return JSON.parse(tagRoot?.dataset.palette ?? '{}'); } catch { return {}; } })();
  const COLOR_FALLBACK = 'bg-gray-200 text-gray-700';

  function renderTags(box, tags) {
    box.querySelectorAll('.order-tag').forEach((n) => n.remove());
    const anchor = box.querySelector('.tag-input') ?? null;
    for (const item of tags) {
      const badge = document.createElement('span');
      badge.className = `order-tag inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs ${palette[item.color] ?? COLOR_FALLBACK}`;
      const link = document.createElement('a');
      link.className = 'hover:underline';
      link.href = `/admin/orders?tag=${encodeURIComponent(item.tag)}`;
      link.textContent = item.tag;
      badge.appendChild(link);
      if (anchor) {
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'tag-remove leading-none opacity-60 hover:opacity-100';
        x.dataset.tag = item.tag;
        x.setAttribute('aria-label', window.t('admin.orders.tagRemove', { tag: item.tag }));
        x.textContent = '×';
        badge.appendChild(x);
      }
      box.insertBefore(badge, anchor);
    }
  }

  async function addTag(box) {
    const input = box.querySelector('.tag-input');
    const value = input.value.trim();
    if (!value) return;
    const res = await api.post(`/api/orders/${encodeURIComponent(box.dataset.order)}/tags`, { tag: value });
    if (!res.ok) {
      // The server's own sentence for the limit / bad characters; the
      // translated one only when it sent nothing.
      alert(res.error || window.t('admin.orders.tagFailed'));
      return;
    }
    input.value = '';
    renderTags(box, res.data.tags);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const input = e.target.closest?.('.tag-input');
    if (!input) return;
    e.preventDefault();
    addTag(input.closest('.order-tags'));
  });

  document.addEventListener('click', async (e) => {
    const addBtn = e.target.closest('.tag-add');
    if (addBtn) { await addTag(addBtn.closest('.order-tags')); return; }

    const rm = e.target.closest('.tag-remove');
    if (rm) {
      const box = rm.closest('.order-tags');
      const res = await api.delete(
        `/api/orders/${encodeURIComponent(box.dataset.order)}/tags?tag=${encodeURIComponent(rm.dataset.tag)}`,
      );
      if (res.ok) renderTags(box, res.data.tags);
      else alert(res.error || window.t('admin.orders.tagFailed'));
      return;
    }

    const rename = e.target.closest('.tag-rename');
    if (rename) {
      const to = prompt(window.t('admin.orders.tagRenamePrompt', { tag: rename.dataset.tag, count: rename.dataset.count }), rename.dataset.tag);
      if (to === null || !to.trim()) return;
      const res = await api.patch('/api/orders/tags', { from: rename.dataset.tag, to });
      if (!res.ok) return alert(res.error || window.t('admin.orders.tagRenameFailed'));
      if (res.data?.failed) alert(window.t('admin.orders.tagsPartial', { failed: res.data.failed }));
      location.reload();
      return;
    }

    const del = e.target.closest('.tag-delete');
    if (del) {
      if (!confirm(window.t('admin.orders.tagDeleteConfirm', { tag: del.dataset.tag, count: del.dataset.count }))) return;
      const res = await api.delete(`/api/orders/tags?tag=${encodeURIComponent(del.dataset.tag)}`);
      if (!res.ok) return alert(res.error || window.t('admin.orders.tagDeleteFailed'));
      if (res.data?.failed) alert(window.t('admin.orders.tagsPartial', { failed: res.data.failed }));
      location.reload();
      return;
    }
  });


  // ---- Order timeline. Loaded when a row's <details> is opened.
  const ordersRoot = document.getElementById('orders-root');
  const parseJson = (v) => { try { return JSON.parse(v ?? '{}'); } catch { return {}; } };
  const TL_LABELS = parseJson(ordersRoot?.dataset.tlLabels);
  const TL_UI = parseJson(ordersRoot?.dataset.tlUi);
  const TL_STATUS = parseJson(ordersRoot?.dataset.statusLabels);
  const TL_LOCALE = ordersRoot?.dataset.locale || undefined;
  const TL_DOT = {
    status: 'bg-blue-500', payments: 'bg-green-500', shipments: 'bg-orange-500', notes: 'bg-gray-400', other: 'bg-indigo-400',
  };
  const TL_PAGE = 20;

  function tlMoney(cents, currency, negative) {
    let text;
    try {
      const f = new Intl.NumberFormat(TL_LOCALE, { style: 'currency', currency: currency || 'EUR' });
      const digits = f.resolvedOptions().maximumFractionDigits;
      text = f.format(cents / 10 ** digits);
    } catch { text = (cents / 100).toFixed(2); }
    return negative ? `−${text}` : text;
  }

  function tlWho(item) {
    if (item.actor_kind === 'staff') return item.actor_name || '';
    if (item.actor_kind === 'unknown') return '';
    return TL_UI.actors?.[item.actor_kind] || '';
  }

  function tlRow(item, currency) {
    const li = document.createElement('li');
    li.className = 'flex gap-2';
    const dot = document.createElement('span');
    dot.className = `mt-1.5 h-2 w-2 shrink-0 rounded-full ${TL_DOT[item.category] ?? 'bg-gray-400'}`;
    li.appendChild(dot);
    const body = document.createElement('div');
    body.className = 'min-w-0 break-words';
    const head = document.createElement('div');
    const title = document.createElement('span');
    title.className = 'font-medium text-gray-900';
    let label = TL_LABELS[item.event] ?? item.event;
    if (item.event === 'status.changed' && item.from && item.to) {
      label = `${label}: ${TL_STATUS[item.from] ?? item.from} → ${TL_STATUS[item.to] ?? item.to}`;
    }
    title.textContent = label;
    head.appendChild(title);
    if (item.amount_cents !== undefined) {
      const refund = item.event === 'refund.issued' || item.event === 'payment.refunded';
      const amt = document.createElement('span');
      amt.className = `ml-2 ${refund ? 'text-purple-700' : 'text-green-700'}`;
      amt.textContent = tlMoney(item.amount_cents, item.currency || currency, refund);
      head.appendChild(amt);
    }
    body.appendChild(head);
    const detail = [];
    if (item.added?.length) detail.push(`+ ${item.added.join(', ')}`);
    if (item.removed?.length) detail.push(`− ${item.removed.join(', ')}`);
    if (item.count) detail.push((TL_UI.declinedTimes || '{count}').replace('{count}', String(item.count)));
    if (item.ref) detail.push(item.ref);
    if (item.text && item.event !== 'order.placed' && item.event !== 'payment.started') detail.push(item.text);
    if (detail.length) {
      const d = document.createElement('div');
      d.className = 'text-xs text-gray-700 whitespace-pre-line';
      d.textContent = detail.join(' · ');
      body.appendChild(d);
    }
    const meta = document.createElement('div');
    meta.className = 'text-xs text-gray-500';
    const when = new Date(item.at);
    const who = tlWho(item);
    meta.textContent = (Number.isNaN(when.getTime()) ? item.at : when.toLocaleString(TL_LOCALE))
      + (who ? ` · ${(TL_UI.by || '{name}').replace('{name}', who)}` : '');
    body.appendChild(meta);
    li.appendChild(body);
    return li;
  }

  async function tlLoad(box, reset) {
    const list = box.querySelector('.tl-list');
    const status = box.querySelector('.tl-status');
    const more = box.querySelector('.tl-more');
    if (reset) { list.replaceChildren(); box.dataset.offset = '0'; }
    const offset = Number(box.dataset.offset || 0);
    const filter = box.querySelector('.tl-filter').value;
    status.textContent = TL_UI.loading || '';
    const q = new URLSearchParams({ limit: String(TL_PAGE), offset: String(offset) });
    if (filter) q.set('filter', filter);
    const res = await api.get(`/api/orders/${encodeURIComponent(box.dataset.order)}/timeline?${q}`);
    if (!res.ok) { status.textContent = res.error || TL_UI.failed || ''; return; }
    for (const item of res.data) list.appendChild(tlRow(item, box.dataset.currency));
    box.dataset.offset = String(offset + res.data.length);
    status.textContent = list.children.length === 0 ? (TL_UI.empty || '') : '';
    more.classList.toggle('hidden', !res.meta?.hasMore);
  }

  document.addEventListener('toggle', (e) => {
    const box = e.target;
    if (!(box instanceof HTMLElement) || !box.classList.contains('order-timeline') || !box.open) return;
    if (box.dataset.loaded) return;
    box.dataset.loaded = '1';
    tlLoad(box, true);
  }, true);

  document.addEventListener('change', (e) => {
    const f = e.target.closest?.('.tl-filter');
    if (f) tlLoad(f.closest('.order-timeline'), true);
  });

  document.addEventListener('click', async (e) => {
    const more = e.target.closest?.('.tl-more');
    if (more) { await tlLoad(more.closest('.order-timeline'), false); return; }
    const add = e.target.closest?.('.tl-add');
    if (add) {
      const box = add.closest('.order-timeline');
      const field = box.querySelector('.tl-comment');
      const text = field.value.trim();
      if (!text) return;
      const res = await api.post(`/api/orders/${encodeURIComponent(box.dataset.order)}/timeline`, { text });
      if (!res.ok) { alert(res.error || TL_UI.commentFailed || ''); return; }
      field.value = '';
      await tlLoad(box, true);
    }
  });

  document.addEventListener('click', async (e) => {
    // Dispatch on the CLASS, never the translated label.
    const ship = e.target.closest('.ship-save');
    if (ship) {
      const id = ship.dataset.id;
      const row = ship.closest('div');
      const res = await api.post(`/api/orders/${encodeURIComponent(id)}/ship`, {
        tracking_carrier: row.querySelector('.ship-carrier')?.value ?? '',
        tracking_number: row.querySelector('.ship-number')?.value ?? '',
      });
      if (res.ok) location.reload();
      else alert(res.error || window.t('admin.orders.trackingFailed'));
      return;
    }

    const rx = e.target.closest('.delete-rx');
    if (rx) {
      if (!confirm(window.t('admin.orders.prescriptionDeleteConfirm', { number: rx.dataset.number }))) return;
      const res = await api.delete(
        `/api/orders/${encodeURIComponent(rx.dataset.order)}/prescription?line=${encodeURIComponent(rx.dataset.line)}`,
      );
      if (res.ok) location.reload();
      else alert(res.error || window.t('admin.orders.prescriptionDeleteFailed'));
      return;
    }

    const btn = e.target.closest('.refund-btn');
    if (!btn) return;

    const remaining = Number(btn.dataset.remaining);
    const cur = btn.dataset.currency || 'EUR';
    const fmt = (c) => (c / 100).toFixed(2);

    const entered = prompt(
      window.t('admin.orders.refundPromptTitle', { number: btn.dataset.number, provider: btn.dataset.provider }) +
        '\n\n' +
        window.t('admin.orders.refundPromptMax', { amount: fmt(remaining), currency: cur }) +
        '\n' +
        window.t('admin.orders.refundPromptEnter', { amount: fmt(remaining), currency: cur }),
      '',
    );
    if (entered === null) return; // cancelled

    let amountCents = null;
    if (entered.trim() !== '') {
      const parsed = Number(entered.replace(',', '.'));
      if (!Number.isFinite(parsed) || parsed <= 0) return alert(window.t('admin.orders.amountInvalid'));
      amountCents = Math.round(parsed * 100);
      if (amountCents > remaining) {
        return alert(window.t('admin.orders.amountTooHigh', { amount: fmt(remaining), currency: cur }));
      }
    }

    const label = amountCents === null
      ? window.t('admin.orders.refundFullAmount', { amount: fmt(remaining), currency: cur })
      : `${fmt(amountCents)} ${cur}`;
    if (!confirm(window.t('admin.orders.refundConfirm', { amount: label }))) return;

    btn.disabled = true;
    btn.textContent = window.t('admin.orders.refunding');
    const res = await api.post(`/api/orders/${btn.dataset.id}/refund`,
      amountCents === null ? {} : { amount_cents: amountCents });
    if (res.ok) location.reload();
    else {
      alert(res.error || window.t('admin.orders.refundFailed'));
      btn.disabled = false;
      btn.textContent = window.t('admin.orders.refund');
    }
  });
</script>
