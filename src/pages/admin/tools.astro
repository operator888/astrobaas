---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { LocalDB } from '../../lib/localdb';
import { auditSections } from '../../lib/section-audit';
import { resolvePatterns } from '../../lib/pattern-registry';
import { isDeclarativeRecord } from '../../lib/manifest-runtime';
import { installedSections } from '../../lib/manifest-sections';
import type { PluginManifest } from '../../core/manifest';
import { resolveActiveTheme } from '../../lib/theme-runtime';
import { canOpenAdminPage } from '../../lib/admin-access';
import { escapeHtml } from '../../lib/escape-html';

const user = Astro.locals.user;
// One rule, asked — not re-implemented. A hand-written role test here is
// how the page, the middleware and the sidebar drift apart.
if (!canOpenAdminPage('/admin/tools', user?.role)) {
  return Astro.redirect('/admin');
}

const t = Astro.locals.t;

// Read-only. Sections live as CSS classes inside stored HTML, so the vocabulary
// (code) and the content (database) can drift apart silently — this is the
// screen that makes that visible rather than letting it surface as a page that
// mysteriously loses its layout the next time somebody edits it.
await LocalDB.init();
// The audit knows the CORE vocabulary from code, but the plugin vocabulary
// only from here. Without this every page using a healthy plugin section would
// be reported as broken.
const activeManifests = (await LocalDB.getPlugins())
  .filter((r) => r.active && isDeclarativeRecord(r.settings))
  .map((r) => (r.settings as { manifest: PluginManifest }).manifest);
// Every class an active plugin can legitimately put in content: the section
// root AND each modifier class it declares. Feeding only the roots made the
// audit flag every ab-x-<plugin>-<group>-<value> on a healthy page as
// orphaned, listing live content under "plugins that are not active".
const installedClasses = activeManifests.flatMap((m) => installedSections(m).flatMap((sec) => [
  sec.className,
  ...Object.entries(sec.modifiers ?? {}).flatMap(([group, values]) =>
    (values as string[]).map((v) => `${sec.modifierPrefix}${group}-${v}`),
  ),
]));
const audit = auditSections(await LocalDB.getPosts(), installedClasses);
const activeTheme = await resolveActiveTheme();
const { patterns, rejected } = resolvePatterns(activeTheme.patterns, activeTheme.id);

// The paths are literals and must not be translated, but where they fall in the
// sentence is a translator's decision — so they go in as markup parameters
// rather than splitting one sentence into three keys.
const codeDb = '<code class="bg-gray-100 px-1 rounded">db.json</code>';
const codeUploads = '<code class="bg-gray-100 px-1 rounded">public/uploads/</code>';
---

<AdminLayout title={t('admin.tools.title')}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">{t('admin.tools.title')}</h1>
      <p class="text-gray-600 mt-2">{t('admin.tools.subtitle')}</p>
    </div>

    <div id="tools-notice" class="hidden mb-4 px-3 py-2 rounded-md border text-sm"></div>

    <!-- Backup -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">{t('admin.tools.backupHeading')}</h2>
      <p
        class="text-sm text-gray-600 mb-4"
        set:html={t('admin.tools.backupDesc', { db: codeDb, uploads: codeUploads })}
      />
      <a href="/api/backup/export" class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium">
        {t('admin.tools.backupDownload')}
      </a>
    </div>

    <!-- Restore -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">{t('admin.tools.restoreHeading')}</h2>
      <p class="text-sm text-gray-600 mb-4">
        {t('admin.tools.restoreDesc')} <strong>{t('admin.tools.restoreWarning')}</strong>
      </p>
      <form id="restore-form" class="space-y-4">
        <input id="restore-file" type="file" accept="application/json"
          class="block text-sm text-gray-700 file:mr-4 file:px-3 file:py-2 file:rounded-lg file:border-0 file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200" />
        <button type="submit" id="restore-btn" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium disabled:opacity-50" disabled>
          {t('admin.tools.restoreSubmit')}
        </button>
      </form>
    </div>

    <!-- Section health -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">{t('admin.tools.sectionsHeading')}</h2>
      <p class="text-sm text-gray-600 mb-4">{t('admin.tools.sectionsDesc')}</p>

      <dl class="grid grid-cols-3 gap-4 mb-4">
        <div class="rounded-md border border-gray-200 p-3">
          <dt class="text-xs text-gray-500">{t('admin.tools.statScanned')}</dt>
          <dd class="text-2xl font-semibold text-gray-900">{audit.scanned}</dd>
        </div>
        <div class="rounded-md border border-gray-200 p-3">
          <dt class="text-xs text-gray-500">{t('admin.tools.statUsingSections')}</dt>
          <dd class="text-2xl font-semibold text-gray-900">{audit.usingSections}</dd>
        </div>
        <div class={`rounded-md border p-3 ${audit.unknownTotals.length ? 'border-amber-300 bg-amber-50' : 'border-gray-200'}`}>
          <dt class="text-xs text-gray-500">{t('admin.tools.statNeedingAttention')}</dt>
          <dd class={`text-2xl font-semibold ${audit.unknownTotals.length ? 'text-amber-700' : 'text-gray-900'}`}>
            {audit.affected.filter((r) => r.unknownClasses.length).length}
          </dd>
        </div>
      </dl>

      {audit.orphanedTotals.length > 0 && (
        <div class="rounded-md border border-blue-200 bg-blue-50 px-3 py-2 mb-3">
          <h3 class="text-sm font-medium text-blue-900 mb-1">{t('admin.tools.orphanedHeading')}</h3>
          <ul class="text-sm text-blue-900 space-y-0.5">
            {audit.orphanedTotals.map((u) => (
              <li>
                <code class="bg-white/60 px-1 rounded">{u.className}</code>
                <span> {t('admin.tools.inRecords', undefined, { count: u.records })}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs text-blue-800 mt-1">{t('admin.tools.orphanedNote')}</p>
        </div>
      )}

      {audit.unknownTotals.length === 0 ? (
        <p class="text-sm text-green-700 bg-green-50 border border-green-200 rounded-md px-3 py-2">
          {t('admin.tools.sectionsAllKnown')}
        </p>
      ) : (
        <div class="space-y-3">
          <div>
            <h3 class="text-sm font-medium text-gray-800 mb-1">{t('admin.tools.unknownHeading')}</h3>
            <ul class="text-sm text-gray-700 space-y-0.5">
              {audit.unknownTotals.map((u) => (
                <li>
                  <code class="bg-amber-50 border border-amber-200 px-1 rounded">{u.className}</code>
                  <span class="text-gray-500"> {t('admin.tools.inRecords', undefined, { count: u.records })}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-medium text-gray-800 mb-1">{t('admin.tools.affectedHeading')}</h3>
            <ul class="text-sm space-y-0.5">
              {audit.affected.filter((r) => r.unknownClasses.length).slice(0, 50).map((r) => (
                <li>
                  <a href={`/admin/posts/${r.id}/edit`} class="text-blue-600 hover:underline">{r.title}</a>
                  <span class="text-gray-500"> ({r.kind}, {r.status}) — {r.unknownClasses.join(', ')}</span>
                </li>
              ))}
            </ul>
            {audit.affected.length > 50 && (
              <p class="text-xs text-gray-500 mt-1">
                {t('admin.tools.affectedTruncated', { total: audit.affected.length })}
              </p>
            )}
          </div>
          <p class="text-xs text-gray-500">{t('admin.tools.affectedNote')}</p>
        </div>
      )}

      {audit.usingSections > 0 && (
        <details class="mt-4">
          <summary class="text-sm text-gray-600 cursor-pointer">{t('admin.tools.usageSummary')}</summary>
          <ul class="mt-2 text-sm text-gray-700 grid grid-cols-2 gap-x-6">
            {audit.usage.map((u) => (
              <li class="flex justify-between border-b border-gray-100 py-0.5">
                <span>{u.name}</span>
                <span class="text-gray-500">{u.records}</span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>

    <!-- Patterns -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">{t('admin.tools.patternsHeading')}</h2>
      <p class="text-sm text-gray-600 mb-3">{t('admin.tools.patternsDesc')}</p>
      <p
        class="text-sm text-gray-700 mb-3"
        set:html={t(
          'admin.tools.patternsAvailable',
          {
            countStrong: `<strong>${patterns.length}</strong>`,
            theme: escapeHtml(activeTheme.id),
            tier: escapeHtml(activeTheme.tier),
          },
          { count: patterns.length },
        )}
      />
      {rejected.length > 0 && (
        <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2">
          <h3 class="text-sm font-medium text-amber-800 mb-1">{t('admin.tools.patternsRejectedHeading')}</h3>
          <ul class="text-sm text-amber-900 space-y-0.5">
            {rejected.map((r) => (
              <li><code class="bg-white/60 px-1 rounded">{r.name}</code> ({r.source}) — {r.reason}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- Reset to seed -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">{t('admin.tools.otherHeading')}</h2>
      <p class="text-sm text-gray-600" set:html={t('admin.tools.otherDesc', { db: codeDb })} />
    </div>
  </div>
</AdminLayout>

<script>
  // @ts-nocheck
  import { apiFetch } from '../../lib/apiClient';
  import { flash as sharedFlash } from '../../lib/admin-ui';

  const notice = document.getElementById('tools-notice');
  function flash(msg, kind = 'success') {
    // The shared helper, not a seventh copy of the class string. Tailwind scans
    // source TEXT for class names, so the branches there are written out in
    // full — a composed `bg-${c}-50` is not in the stylesheet and the notice
    // renders unstyled in a production build while looking right in dev.
    sharedFlash(notice, msg, kind === 'success' ? 'success' : 'error');
  }

  const fileInput = document.getElementById('restore-file');
  const btn = document.getElementById('restore-btn');
  fileInput.addEventListener('change', () => {
    btn.disabled = !fileInput.files || !fileInput.files[0];
  });

  document.getElementById('restore-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const file = fileInput.files?.[0];
    if (!file) return;
    if (!confirm(window.t('admin.tools.restoreConfirm'))) return;

    const text = await file.text();
    let parsed;
    try {
      parsed = JSON.parse(text);
    } catch {
      return flash(window.t('admin.tools.restoreInvalidJson'), 'error');
    }

    btn.disabled = true;
    btn.textContent = window.t('admin.tools.restoreInProgress');
    const res = await apiFetch('/api/backup/import', { method: 'POST', json: parsed });
    btn.disabled = false;
    btn.textContent = window.t('admin.tools.restoreSubmit');
    if (!res.ok) return flash(window.t('admin.tools.restoreFailed', { error: res.error }), 'error');
    // The route returns things a restore MEANS — a restart requirement, and the
    // archive's own notes ("the uploads were NOT included"). Both were written
    // by the backup half of the codebase and read by neither, so an operator
    // saw "restored" and nothing else.
    let msg = window.t('admin.tools.restoreComplete',
      { restored: res.data.restored, skipped: res.data.skipped });
    if (res.data.restartRequired) {
      msg += ' RESTART the site now — an open connection still holds the previous database file, '
        + 'so nothing on screen is the restored data yet.';
    }
    if (Array.isArray(res.data.notes) && res.data.notes.length) {
      msg += ' ' + res.data.notes.join(' ');
    }
    flash(msg, res.data.restartRequired ? 'error' : undefined);
  });
</script>
