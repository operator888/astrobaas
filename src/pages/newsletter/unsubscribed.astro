---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { routeHref } from '../../lib/locale-links';

/**
 * Where an unsubscribe link lands.
 *
 * Links nowhere off-site: the URL that got here carries a signed token holding
 * an email address, and an outbound link could leak it in a Referer header.
 */
const ok = Astro.url.searchParams.get('ok') === '1';
const title = ok ? 'You have been unsubscribed' : 'That link did not work';
---

<PublicLayout title={title} description="Newsletter">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="max-w-2xl mx-auto px-4 py-20 text-center">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">{title}</h1>
    {ok ? (
      <p class="text-gray-600">
        Your address has been removed from the list. You will not receive anything
        further, and nothing about you is kept.
      </p>
    ) : (
      <p class="text-gray-600">
        The link may have been altered in transit. If you are still receiving emails,
        reply to any of them and we will remove you by hand.
      </p>
    )}
    <p class="mt-8"><a href={routeHref('/', Astro.locals.locale)} class="text-blue-600 hover:underline">Back to the site</a></p>
  </section>
</PublicLayout>
