---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LocalDB } from '../lib/localdb';
import { settingsMap } from '../lib/settings-map';
import { resolveBranding } from '../lib/branding';

const token = Astro.url.searchParams.get('token') ?? '';

await LocalDB.init();
const branding = resolveBranding(settingsMap(await LocalDB.getSettings()));
---

<BaseLayout title={`Choose a new password - ${branding.name}`} description="Set a new password">
  <main class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="w-full max-w-sm bg-white border border-gray-200 rounded-xl shadow-sm p-8">
      <h1 class="text-2xl font-semibold text-gray-900 mb-1">Choose a new password</h1>
      <p class="text-sm text-gray-500 mb-6">Enter a new password for your account.</p>

      <div id="error" class="mb-4 px-3 py-2 rounded-md bg-red-50 border border-red-200 text-sm text-red-700 hidden"></div>
      <div id="ok" class="mb-4 px-3 py-2 rounded-md bg-green-50 border border-green-200 text-sm text-green-700 hidden">
        Your password has been reset. <a href="/login" class="font-medium underline">Sign in</a>.
      </div>

      {!token && (
        <p class="text-sm text-red-700">This link is missing its reset token. Request a new one from
          <a href="/forgot-password" class="text-blue-600 hover:underline">Forgot password</a>.</p>
      )}

      {token && (
        <form id="reset-form" class="space-y-4">
          <input type="hidden" id="token" value={token} />
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">New password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <p class="text-xs text-gray-400 mt-1">At least 8 characters.</p>
          </div>
          <button type="submit" class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors">
            Reset password
          </button>
        </form>
      )}
    </div>
  </main>

  <script>
    const form = document.getElementById('reset-form');
    const errBox = document.getElementById('error');
    const okBox = document.getElementById('ok');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox!.classList.add('hidden');
      const token = (document.getElementById('token') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      try {
        const res = await fetch('/api/auth/reset', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, password }),
        });
        const json = await res.json().catch(() => null);
        if (res.ok && json?.success) {
          (form as HTMLFormElement).classList.add('hidden');
          okBox!.classList.remove('hidden');
        } else {
          errBox!.textContent = json?.error?.message || 'Could not reset your password.';
          errBox!.classList.remove('hidden');
        }
      } catch {
        errBox!.textContent = 'Something went wrong. Please try again.';
        errBox!.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
