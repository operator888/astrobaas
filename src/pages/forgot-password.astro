---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LocalDB } from '../lib/localdb';
import { settingsMap } from '../lib/settings-map';
import { resolveBranding } from '../lib/branding';

// C-159. An auth page that still said "AstroBaaS" would make the setting look
// half-applied to the only people who ever see these screens.
await LocalDB.init();
const branding = resolveBranding(settingsMap(await LocalDB.getSettings()));
---

<BaseLayout title={`Reset password - ${branding.name}`} description="Request a password reset">
  <main class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="w-full max-w-sm bg-white border border-gray-200 rounded-xl shadow-sm p-8">
      <h1 class="text-2xl font-semibold text-gray-900 mb-1">Forgot your password?</h1>
      <p class="text-sm text-gray-500 mb-6">Enter your email and we'll send a reset link.</p>

      <div id="msg" class="mb-4 px-3 py-2 rounded-md bg-green-50 border border-green-200 text-sm text-green-700 hidden"></div>

      <form id="forgot-form" class="space-y-4" data-captcha="forgot">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="username"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
        </div>
        <button type="submit" class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors">
          Send reset link
        </button>
      </form>

      <p class="text-xs text-gray-500 mt-6">
        Remembered it? <a href="/login" class="text-blue-600 hover:underline">Back to sign in</a>.
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById('forgot-form');
    const msg = document.getElementById('msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value;
      try {
        const res = await fetch('/api/auth/forgot', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, pow_token: (new FormData(form as HTMLFormElement).get('pow_token') || '').toString() || undefined }),
        });
        const json = await res.json().catch(() => null);
        // The endpoint always returns the same generic message (no enumeration).
        msg!.textContent = json?.message || 'If that email is registered, a reset link has been sent.';
        msg!.classList.remove('hidden');
        (form as HTMLFormElement).reset();
      } catch {
        msg!.textContent = 'Something went wrong. Please try again.';
        msg!.classList.remove('hidden');
      }
    });
  </script>
<script is:inline src="/captcha.js" defer></script>
</BaseLayout>
