---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LocalDB } from '../lib/localdb';
import { emailChannelActive } from '../lib/email';
import { settingsMap } from '../lib/settings-map';
import { resolveBranding } from '../lib/branding';
import { DEFAULT_ADMIN_EMAIL, seedAdminEmail } from '../lib/seed-data';
import { makeChallenge } from '../lib/captcha';

// Ensure seed admin exists so first-time visitors can log in.
await LocalDB.init();

// What this install calls itself (C-159). The sign-in page is the FIRST thing
// a white-label operator's staff sees, so leaving it hardcoded would have made
// the setting look broken.
const branding = resolveBranding(settingsMap(await LocalDB.getSettings()));

// Passwordless sign-in is offered ONLY when an email can actually leave this
// server — with the console transport the "link" would land in a log, and a
// visitor who requests one experiences a broken product, not a slow inbox.
// The API enforces the same gate; this just keeps the promise off the page.
const magicAvailable = emailChannelActive();

/**
 * Is the bootstrap address still the obvious placeholder?
 *
 * The prefilled value and the credentials hint below are a convenience for a
 * brand-new install. Once `ADMIN_EMAIL` names a REAL person, printing it on a
 * public, unauthenticated page hands every scanner half of a valid login for
 * free — so the convenience is withdrawn exactly when it stops being harmless.
 */
const showsSeedHint = seedAdminEmail() === DEFAULT_ADMIN_EMAIL;

// If already logged in, jump to admin.
const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/admin');
}

const params = Astro.url.searchParams;
const error = params.get('error');
const next = params.get('next') || '/admin';
// Second step of a 2FA login: the password was already verified and a
// short-lived pending cookie is set, so we only ask for the code here.
const twofa = params.get('twofa') === '1';

const sent = params.get('sent') === '1';

/**
 * A proof-of-work challenge for the password form, minted with the page (S3.9).
 *
 * An account that has failed to sign in too often — from anywhere — is only
 * checked against a password that arrives with a solved challenge. The
 * operator's own login captcha switch may be off, in which case the widget's
 * usual `/api/captcha/challenge` request is told "not enabled" and would solve
 * nothing. So the page carries its own challenge and `/captcha.js` solves it
 * in the background: an owner whose account is being guessed at signs in
 * without noticing, instead of being locked out by the attacker.
 *
 * Minted on every render, cheaply (one HMAC); single-use and ten minutes long.
 * The server ignores it unless it is needed.
 */
const loginChallenge = twofa ? null : makeChallenge('login');

const errorMessage =
  error === 'magic'
    ? 'That sign-in link is no longer valid. Request a fresh one below.'
    : error === 'bad'
      ? 'Invalid email or password.'
    : error === 'rate'
      ? 'Too many attempts. Please wait and try again.'
      : error === 'code'
        ? 'Invalid two-factor code. Try again.'
        : error === 'captcha'
          ? 'The anti-spam check did not pass. JavaScript must be enabled — reload the page and try again.'
          : error === 'pow'
            ? 'This account has had several failed sign-in attempts, so your browser now completes a short security check before signing in. Enter your password again — JavaScript must be enabled.'
            : error
              ? 'Sign in failed.'
              : null;
---

<BaseLayout title={`Sign in - ${branding.name}`} description={`Sign in to the ${branding.name} admin`}>
  <main class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="w-full max-w-sm bg-white border border-gray-200 rounded-xl shadow-sm p-8">
      <div class="flex items-center space-x-2 mb-6">
        {branding.logo ? (
          <img src={branding.logo} alt="" class="w-8 h-8 object-contain" width="32" height="32" />
        ) : (
          <svg class="w-8 h-8 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        )}
        <span class="text-xl font-bold text-gray-900">{branding.name}</span>
      </div>
      <h1 class="text-2xl font-semibold text-gray-900 mb-1">
        {twofa ? 'Two-factor verification' : 'Sign in'}
      </h1>
      <p class="text-sm text-gray-500 mb-6">
        {twofa ? 'Enter the code from your authenticator app.' : 'Use your admin credentials.'}
      </p>

      {errorMessage && (
        <div class="mb-4 px-3 py-2 rounded-md bg-red-50 border border-red-200 text-sm text-red-700">
          {errorMessage}
        </div>
      )}

      {sent && (
        <div class="mb-4 px-3 py-2 rounded-md bg-green-50 border border-green-200 text-sm text-green-700">
          If that email is registered, a sign-in link is on its way. It works once,
          for 15 minutes.
        </div>
      )}

      {twofa ? (
        <form method="POST" action="/api/auth/login" class="space-y-4" id="twofa-form" data-captcha="login">
          <input type="hidden" name="next" value={next} />
          <div>
            <label for="code" class="block text-sm font-medium text-gray-700 mb-1">
              Authenticator code
            </label>
            <input
              type="text"
              id="code"
              name="code"
              required
              inputmode="numeric"
              autocomplete="one-time-code"
              autofocus
              placeholder="123456"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg font-mono tracking-widest text-center focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <p class="text-xs text-gray-500 mt-1">You can also enter one of your backup codes.</p>
          </div>
          <button
            type="submit"
            class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors"
          >
            Verify
          </button>
        </form>

        <p class="text-sm text-gray-500 mt-4">
          <a href="/login" class="text-blue-600 hover:underline">&larr; Back to sign in</a>
        </p>
      ) : (
        <div>
        <form
          method="POST"
          action="/api/auth/login"
          class="space-y-4"
          id="login-form"
          data-captcha="login"
          data-captcha-token={loginChallenge?.token}
          data-captcha-bits={loginChallenge?.bits}
        >
          <input type="hidden" name="next" value={next} />
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="username"
              value={showsSeedHint ? DEFAULT_ADMIN_EMAIL : ''}
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>
          <button
            type="submit"
            class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors"
          >
            Sign in
          </button>
        </form>

        <p class="text-sm text-gray-500 mt-4">
          <a href="/forgot-password" class="text-blue-600 hover:underline">Forgot your password?</a>
        </p>

        {magicAvailable && (
          <div class="mt-6 pt-6 border-t border-gray-200">
            <p class="text-sm font-medium text-gray-700 mb-2">Or sign in without a password</p>
            <form method="POST" action="/api/auth/magic-link" class="flex gap-2" id="magic-form" data-captcha="magic-link">
              <label for="magic-email" class="sr-only">Email for sign-in link</label>
              <input
                type="email"
                id="magic-email"
                name="email"
                required
                placeholder="you@example.com"
                autocomplete="username"
                class="flex-1 min-w-0 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
              <button
                type="submit"
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 whitespace-nowrap"
              >
                Email me a link
              </button>
            </form>
          </div>
        )}

        {showsSeedHint && (
          <p class="text-xs text-gray-500 mt-4">
            Default seed credentials are <code class="bg-gray-100 px-1 rounded">{DEFAULT_ADMIN_EMAIL}</code> /
            <code class="bg-gray-100 px-1 rounded">admin</code>. Change them after first login.
          </p>
        )}
        </div>
      )}
    </div>
  </main>

  <script>
    // If the API responds non-2xx via fetch, the form's regular submit handles
    // the redirect to /login?error=bad on the server side instead. The form
    // intentionally uses standard POST submission so CSRF is not needed for
    // the login flow itself (login produces the session, not consumes it).
  </script>
<script is:inline src="/captcha.js" defer></script>
</BaseLayout>
