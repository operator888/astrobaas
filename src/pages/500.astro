---
import PublicLayout from '../layouts/PublicLayout.astro';
import { routeHref } from '../lib/locale-links';
import { isProductionRuntime } from '../lib/auth';

const err = (Astro.props as any).error;
// isProductionRuntime(), not NODE_ENV: `node dist/server/entry.mjs` under
// systemd or PM2 does not set NODE_ENV, and the stack would reach visitors.
const showDetails =
  !isProductionRuntime() && err && typeof err.message === 'string';
---

<PublicLayout title="Something went wrong" description="An internal error occurred.">
  <section class="min-h-[60vh] flex items-center justify-center px-4 py-16">
    <div class="text-center max-w-lg">
      <p class="text-sm font-medium text-red-600 mb-3">500</p>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Something went wrong.</h1>
      <p class="text-gray-600 mb-6">
        The server hit an unexpected error while loading this page. The site administrator
        has been notified. You can try again in a moment.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-8">
        <a href={routeHref('/', Astro.locals.locale)} class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium">
          Go home
        </a>
        <button id="retry-btn" type="button" class="px-4 py-2 border border-gray-300 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">
          Try again
        </button>
      </div>
      {showDetails && (
        <details class="text-left bg-gray-50 border border-gray-200 rounded-lg p-4">
          <summary class="cursor-pointer text-sm font-medium text-gray-700">Error details (dev only)</summary>
          <pre class="mt-3 text-xs text-gray-700 overflow-auto whitespace-pre-wrap">{err.stack || err.message}</pre>
        </details>
      )}
    </div>
  </section>

  <script>
    // Bundled (external) — CSP-safe replacement for an inline onclick handler.
    document.getElementById('retry-btn')?.addEventListener('click', () => window.location.reload());
  </script>
</PublicLayout>
