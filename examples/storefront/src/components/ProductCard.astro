---
import type { Product } from '../lib/cms';
import { priceOf } from '../lib/cms';
import { formatMoney } from '../lib/money';
import { stockBadge } from '../lib/stock';
import { isGroup } from '../lib/group';

interface Props { product: Product; currency: string }
const { product, currency } = Astro.props;
const { now, was, from } = priceOf(product);
const image = product.images?.find((i) => (i.kind ?? 'image') === 'image');
const stock = stockBadge(product);
---
<li class="card">
  <a href={`/product/${product.slug}/`}>
    <div class="card-img">
      {image
        ? <img src={image.src} alt={image.alt ?? ''} loading="lazy" width="400" height="400" />
        : null}
    </div>
    <span class="card-name">{product.name}</span>
  </a>
  <span class="price">
    {isGroup(product) && 'From '}
    {was !== null && <span class="visually-hidden">Sale price </span>}
    {from && <span>From </span>}{formatMoney(now, currency)}
    {was !== null && <del><span class="visually-hidden">Was </span>{formatMoney(was, currency)}</del>}
  </span>
  <span class={`stock stock-${stock.tone}`}>{stock.label}</span>
</li>
