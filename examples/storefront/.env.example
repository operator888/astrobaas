# The AstroBaaS CMS this storefront reads from — its origin only, no path.
# The CMS must list THIS site's origin in CORS_ORIGINS, or the cart and
# checkout are refused by the browser.
PUBLIC_CMS_URL=http://localhost:4321

# Shown in the header and page titles.
PUBLIC_SHOP_NAME=My Shop
PUBLIC_SHOP_TAGLINE=

# Two-letter country codes the checkout offers, comma-separated. Empty = a
# default list of European countries plus US, CA, AU.
PUBLIC_SHIP_COUNTRIES=

# This site's own public address, for canonical URLs. Optional.
STOREFRONT_URL=
