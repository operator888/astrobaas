# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
.output/
.vercel/
.netlify/
.astro/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local database (seeded from db.seed.json on first boot)
db.json
# The atomic-write temp twin. lowdb writes `.db.json.tmp` and renames it, so a
# process killed mid-write leaves one behind — holding the operator's database,
# next to a `db.json` that is ignored precisely because it holds that. Without
# this line the leftover is the one file `git add -A` would happily commit.
.db.json.tmp
*.db.json.tmp
# Lease files beside a lowdb database (src/lib/lease.ts): who runs the
# scheduler, who is migrating. Process state, never content.
*.lease
*.lease.lock
*.lease.*.tmp

# Local upload storage (keep the directory, ignore its contents)
public/uploads/*
!public/uploads/.gitkeep

# macOS-specific files
.DS_Store

# Windows-specific files
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Playwright
test-results/
playwright-report/
.claude/
.claude/launch.json

# Published library build (scripts/build-pkg.mjs)
pkg/
.deploy/

# Real store exports. A WooCommerce export carries customer names, emails,
# phone numbers and street addresses — personal data under GDPR, and a commit
# is permanent. Synthetic fixtures live in data/import.example/ instead.
data/import/
deploy.local.sh
private-uploads/
screenshots/

# Assistant and editor working files — never part of a release.
# .claude/, .vscode/ and .idea/ are listed above; these are the rest.
CLAUDE.md
AGENTS.md
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.aider*
.continue/
.github/copilot-instructions.md
*.code-workspace

# Staged by scripts/build-mcp-pkg.mjs from bin/ at publish time — one source.
packages/astrobaas-mcp/astrobaas-mcp.mjs
packages/astrobaas-mcp/lib/
packages/astrobaas-mcp/LICENSE
