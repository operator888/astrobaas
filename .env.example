# AstroBaaS environment variables. Copy to .env and edit.

# Required in production: HMAC key for session + CSRF cookies.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-32-byte-random-hex-string

# The value above is a PLACEHOLDER and is public: a production build refuses
# it, logs why at startup, and nobody can sign in until you replace it. The
# same happens when AUTH_SECRET is missing or shorter than 16 characters.
#
# A production build also gives session/CSRF cookies the Secure flag (so you
# MUST serve over HTTPS, or set COOKIE_SECURE=0 to test on plain localhost).
#
# `npm start` does not read this file. Export the variables yourself, or:
#   node --env-file=.env ./dist/server/entry.mjs

# A built server is production whether or not this is set; `npm start` sets it.
# NODE_ENV=production

# Public base URL — used for absolute links in sitemap.xml, rss.xml and OG tags.
# SITE_URL=https://cms.example.com

# Honour X-Forwarded-For / X-Real-IP for client IPs (rate limiting). Set to 1
# ONLY when behind a reverse proxy you control, otherwise clients can spoof it.
# TRUST_PROXY=1

# Force the cookie Secure flag on/off independently of NODE_ENV (1 or 0).
# Use 0 to test a production build over plain HTTP on localhost.
# COOKIE_SECURE=1

# Requests per minute per IP for /api/* (default 60).
# RATE_LIMIT_PER_MIN=60

# Rate-limit store. Default is in-process (single-node). Set to 'libsql' (with a
# libSQL DATABASE_URL below) to share counters across replicas so the limit is
# correct behind a load balancer.
# RATE_LIMIT_STORE=libsql

# --- The bootstrap admin ---------------------------------------------------
# Read ONCE, on the first boot of an empty install. Changing them later does
# nothing: edit the account in /admin/users instead.

# The address of the account created on first boot. Unset, it is the
# placeholder admin@local — which cannot receive mail, so a password reset has
# nowhere to go. Set your own address here before the first start.
# ADMIN_EMAIL=you@example.com

# The display name on that account, so the sample posts carry your byline.
# ADMIN_NAME=Your Name

# The password for it. In production with none set, a random one is generated
# and printed ONCE to stdout — a default credential in a public repo is a
# published credential.
# ADMIN_PASSWORD=

# --- Database --------------------------------------------------------------
# Persistence engine is chosen by DATABASE_URL:
#   unset           → lowdb JSON file (zero-config local dev; see DB_PATH below)
#   file:...        → local SQLite via libSQL (durable single-host)
#   libsql://...    → remote Turso/libSQL (durable, works on serverless/multi-host)
# Recommended for production: a libsql:// URL (e.g. Turso) so data survives
# redeploys and isn't tied to one machine's disk.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token        # required for remote libsql://
# DATABASE_URL=file:./data/astrobaas.db       # or a local SQLite file
#
# Storage engine for a libSQL DATABASE_URL:
#   unset       → doc-blob (whole dataset in one row; last-write-wins)
#   relational  → per-entity rows (row-level concurrency; recommended for
#                 production multi-writer / multi-host). See STORAGE.md.
# DATABASE_DRIVER=relational
#
# Schema migrations run once per database, under a lease. A process that boots
# while another is migrating waits this long, then fails its init (the next
# request waits again) rather than migrating the same rows at the same time.
# MIGRATION_LOCK_WAIT_MS=120000

# lowdb (default driver) file locations. Ignored when DATABASE_URL is set.
# Point these at a mounted volume in production (the Docker image sets them
# to /app/data/* automatically).
# DB_PATH=/app/data/db.json
# UPLOADS_DIR=/app/data/uploads

# Files strangers attach to public forms. Kept OUT of UPLOADS_DIR, which is
# public. Default: `private-uploads/` beside the database (DB_PATH's directory,
# or a file: DATABASE_URL's) — for plain local dev that is ./private-uploads.
# It must be persistent and writable: the Docker image sets /app/data/..., the
# reference systemd unit sets shared/data/private-uploads. An install that
# already has files in the old default (./private-uploads) keeps using it and
# logs how to move them.
# PRIVATE_UPLOADS_DIR=/app/data/private-uploads

# --- Email (password reset, notifications) -------------------------------
# Transport for outgoing email. Default 'console' just logs the message (fine
# for local dev). 'smtp' sends through any mail server you have an account on
# (below). 'webhook' POSTs the message as JSON to your own endpoint, to bridge
# to Resend/SES/etc.
#
# Check any of these with:   npm run mail:test -- you@example.com
# or, in a built or deployed release (no src/ there):   node dist/mail-test.mjs you@example.com
# (See "Email" in README.md — it prints the SMTP conversation and the server's
# 250, with the password redacted.)
# EMAIL_TRANSPORT=webhook
# EMAIL_WEBHOOK_URL=https://hooks.example.com/email
# EMAIL_WEBHOOK_SECRET=change-me   # optional; adds X-AstroBaaS-Signature header
#
# --- Your own SMTP server ---------------------------------------------------
# What WP Mail SMTP exists to do: point the site at your host's mail server.
# EMAIL_FROM is MANDATORY for this transport — a message without one is rejected
# by every server, and inventing a default would fail at delivery rather than at
# configuration.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=mail.example.gr
# SMTP_PORT=587                    # default 587, or 465 with SMTP_SECURE=1
# SMTP_SECURE=0                    # 1 = implicit TLS from the first byte (465)
# SMTP_USER=shop@example.gr
# SMTP_PASS=''                     # the secret: set it on the server, never commit
#                                  # it. SINGLE-QUOTE it: unquoted, systemd drops a
#                                  # backslash and Node's loader stops at a '#', so a
#                                  # generated password silently fails with a 535.
#                                  # Never logged, never returned by any endpoint.
# EMAIL_FROM=Οπτική Γωνία <shop@example.gr>   # a non-ASCII name is fine; only the
#                                  # NAME is encoded, the address stays readable.
#                                  # Many hosted mailboxes accept ONLY their own
#                                  # address here and reject anything else.
# SMTP_TIMEOUT_MS=10000            # per network wait (connect, TLS handshake, each
#                                  # reply), not per message; one attempt is capped
#                                  # at 3x this. Default 15000. Applies BEFORE the
#                                  # message is sent; the wait after it is below.
# SMTP_DATA_TIMEOUT_MS=600000      # wait for the server's reply to the end of the
#                                  # message. Default 600000 (10 min, RFC 5321);
#                                  # clamped to 1000-1800000. If it runs out, or the
#                                  # connection drops then, the message is NOT resent
#                                  # (the server may have it) and is logged as
#                                  # "outcome unknown". Scheduler batches wait 1 min.
# SMTP_RETRIES=2                   # 0-2, default 2 (on). Transient failures before the message is sent only (4xx, dropped connection, timeout), after ~2 s then ~6 s.
# SMTP_HELO_NAME=cms.example.gr    # name given in EHLO. Default: this machine's FQDN, else EMAIL_FROM's domain.
#
# --- For every transport ----------------------------------------------------
# EMAIL_REPLY_TO=info@example.gr   # Reply-To on every message; if unusable, mail goes without it and a warning says so.
# EMAIL_CAMPAIGNS=0                # 0/false/no/off refuses newsletter campaigns (a one-to-one-only mailbox). Default: allowed.
#
# Two escape hatches, both OFF by default and both a downgrade — set them only
# for a relay you control on your own network:
# SMTP_ALLOW_INSECURE_AUTH=0       # 1 = send credentials without TLS. Base64 is
#                                  #     encoding, not encryption.
# SMTP_ALLOW_SELF_SIGNED=0         # 1 = accept a certificate that cannot be
#                                  #     verified, so the session may be with anyone.
# Reset links use SITE_URL as their origin (falls back to the request origin).
#
# Or activate the bundled SMTP2GO plugin (Admin -> Plugins) and set:
# SMTP2GO_API_KEY=api-XXXXXXXXXXXX
# SMTP2GO_SENDER="My Shop <no-reply@example.com>"

# --- Payments ------------------------------------------------------------
# Nothing is enabled by default. A provider is offered to buyers only when it is
# BOTH listed here AND has every credential below — half-configured providers are
# reported as "misconfigured" in the admin rather than failing at the till.
# Secrets belong HERE, never in the settings table: settings have a public read
# path. Webhook endpoint per provider: /api/payments/webhook/<id>
# See PAYMENTS.md.
# PAYMENTS_ENABLED=stripe,paypal,klarna
#
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # shown when you add the endpoint
#
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...
# PAYPAL_ENV=sandbox                     # or 'live'
#
# KLARNA_USERNAME=...
# KLARNA_PASSWORD=...
# KLARNA_REGION=eu                       # eu | na | oc
# KLARNA_ENV=playground                  # or 'live'
# KLARNA_COUNTRY=DE
# KLARNA_LOCALE=en-DE

# --- Abandoned orders ----------------------------------------------------
# An unpaid order holds its stock reservation. After this many days it is
# cancelled and the stock returned. Configured in Settings, not here:
#   orders_abandon_enabled     (default true)
#   orders_abandon_after_days  (default 3, clamped 1-90)
# The sweep rides the scheduler below, so SCHEDULER_INTERVAL_MS applies.

# --- Scheduled posts -----------------------------------------------------
# A worker auto-publishes status:'scheduled' posts once publish_date passes.
# SCHEDULER_INTERVAL_MS=60000   # sweep cadence (default 60s, floor 100ms)
# SCHEDULER_DISABLED=1          # turn the worker off
#
# With more than one process on the database, only the holder of the
# `scheduler` lease sweeps (a `leases` table on libSQL, a
# <db>.scheduler.lease file beside a lowdb database); the others stand by.
# A leader that dies is replaced once its lease lapses — three intervals by
# default, never less than two intervals plus a second. A clean shutdown
# releases it at once.
# SCHEDULER_LEASE_TTL_MS=180000
# SCHEDULER_LEASE=0             # every process sweeps (old behaviour; one process only)

# --- Observability -------------------------------------------------------
# Expose Prometheus metrics at /metrics (request counters by class, 5xx, 429s,
# a request-latency histogram, in-flight requests, draining, uptime).
# Off by default; keep it behind your network policy when enabled.
# METRICS_ENABLED=1
# Emit one structured JSON log line per request (method, path, status, ms, ip).
# LOG_REQUESTS=1
# (/healthz = liveness, /readyz = readiness — 200 only when storage is reachable
# and the process is not shutting down.)

# Graceful shutdown. On SIGTERM/SIGINT the app answers /readyz with 503, stops
# the scheduler, waits for in-flight requests (a checkout mid-write), writes
# buffered view counts, and exits 0; a second signal exits at once. This is the
# WHOLE budget, and it must be shorter than your supervisor's stop timeout
# (systemd TimeoutStopSec, docker stop / stop_grace_period) or the SIGKILL
# lands first. Default 25000; the Docker image sets 8000 to fit `docker stop`.
# SHUTDOWN_TIMEOUT_MS=25000
# GRACEFUL_SHUTDOWN=0            # opt out: die on the signal, as before

# --- Webhooks ------------------------------------------------------------
# Backoff (ms) between retries of a failed webhook delivery. Comma-separated;
# the count is how many retries follow the first attempt. Default 30s/2m/10m.
# WEBHOOK_RETRY_DELAYS_MS=30000,120000,600000

# --- CORS (headless / cross-origin API access) ---------------------------
# Allow a separate-origin frontend to call /api/* . Space/comma-separated
# origins, or "*" for any. Credentials are never allowed (auth is a bearer
# API key in the Authorization header, not a cookie), so this stays CSRF-safe.
# CORS_ORIGINS=https://my-frontend.example.com http://localhost:3000

# --- Content-Security-Policy ---------------------------------------------
# The CSP defaults to 'self' only. To run 3D/animation libraries, fonts, or
# assets from a CDN, append origins per directive (space- or comma-separated).
# Example: load Three.js/GSAP from jsDelivr + a model host, fonts from Google.
# CSP_SCRIPT_SRC=https://cdn.jsdelivr.net https://unpkg.com
# CSP_STYLE_SRC=https://cdn.jsdelivr.net
# CSP_CONNECT_SRC=https://api.example.com
# CSP_IMG_SRC=https://cdn.example.com
# CSP_FONT_SRC=https://fonts.gstatic.com
# CSP_WORKER_SRC=blob:
# CSP_ALLOW_WASM=1          # allow 'wasm-unsafe-eval' (WASM-based renderers)
# CSP_REPORT_ONLY=1         # report violations without blocking (debugging)
# CSP_DISABLE=1             # drop the CSP header entirely (NOT recommended)

# --- Declarative plugin registry (optional) ---
# JSON index of installable plugin manifests, browsable from the admin UI.
# Each entry's SHA-256 is verified before install. Defaults to the AstroBaaS
# example registry; point it at your own to curate what operators can install.
# PLUGIN_REGISTRY_URL=https://example.com/astrobaas-registry.json
# Set to 1 to disable registry browsing entirely (manifest upload still works).
# PLUGIN_REGISTRY_DISABLED=0

# --- Internationalization (optional) ---
# Comma-separated locales this site serves. Leave UNSET for a single-language
# site (no /xx/ URL prefixes, no locale UI — exactly the pre-i18n behaviour).
# The first entry is the default unless SITE_DEFAULT_LOCALE is set. The default
# locale is never prefixed, so enabling this cannot break existing URLs:
#   /about  → default locale      /de/about → German
# SITE_LOCALES=en,de,fr
# SITE_DEFAULT_LOCALE=en

# --- Post revisions (optional) ---
# How many revisions to retain per post (default 20, hard cap 500). Every save
# and autosave writes one, so retention is what keeps the store bounded.
# REVISIONS_KEEP=20
# Set to 1 to disable revision capture and the autosave endpoint entirely.
# REVISIONS_DISABLED=0

# Seed two demo blog posts on the FIRST boot of an empty database.
# Set to 0 for a shop: an optician's live dashboard leading with "Getting
# Started with AstroBaaS" and 1.2K invented views is not a good first
# impression. Only affects a fresh install — it removes nothing from a store
# that already has them.
SEED_DEMO_CONTENT=1

# Compiled plugins loaded from OUTSIDE this repository — paid modules and
# per-client integrations. Comma-separated module specifiers, each installed
# like any other dependency.
#
#   ASTROBAAS_PLUGINS=@astrobaas/optical
#
# A module named here that fails to load is reported loudly on boot, and so is
# a plugin the database says is ACTIVE with no implementation present — that
# combination means the feature is silently not happening.
# ASTROBAAS_PLUGINS=
#
# Plugins to switch ON automatically, by id. Without this a module shipped in a
# release still has to be activated by hand in every environment — which for a
# shop that already paid for it adds nothing but a chance to forget.
#
#   ASTROBAAS_PLUGINS_ACTIVATE=optical,iris
#
# Deliberately an operator decision, not something a plugin declares about
# itself: a plugin that could activate itself on install could start
# intercepting checkout without anyone choosing to let it.
# ASTROBAAS_PLUGINS_ACTIVATE=
#
# A plugin may also contribute a MANUAL payment method — one that takes no
# credentials and calls no API. The buyer is told what to do, does it somewhere
# else, and a human marks the order paid. Greece's IRIS is the case that forced
# it: a shop registers with its bank, is paid to its phone number, and there is
# nothing to integrate.
#
# Such a method may carry buyer instructions, which /api/payments serves
# PUBLICLY — the buyer is who has to read them. Only put things in there that
# the shop already publishes (an IBAN, a VAT number, the phone number on the
# contact page). Never a credential.

# ---------------------------------------------------------------------------
# Maintenance mode
# ---------------------------------------------------------------------------
# Closes the public site while the process is still RUNNING — a migration, a
# plugin install, a window you opened deliberately. Visitors get 503 with
# Retry-After; /admin, the login pages and the health checks stay reachable, so
# you can always turn it off and your host does not pull the site out of
# rotation.
#
# An environment variable and not a setting, because the commonest reason to
# need this page is that the DATABASE is busy or unreachable — a flag stored
# there would be unreadable exactly when it is wanted. For a planned window,
# use Admin -> Settings -> Maintenance mode instead: that one lets staff keep
# seeing the real site so you can check before reopening.
#
# This cannot cover a redeploy, when the process is stopped and there is no app
# to answer. See MAINTENANCE.md for the static page your reverse proxy serves.
# MAINTENANCE_MODE=1
# MAINTENANCE_MESSAGE=Upgrading the shop — back shortly.
# MAINTENANCE_UNTIL=2026-08-25T18:00:00Z

# Locales whose WITHDRAWAL NOTICE text you have checked against the official
# Directive translation (EUR-Lex 32011L0083, Annex I).
#
# AstroBaaS ships German and Greek versions of the model withdrawal texts, but
# they are reconstructions — good enough to build and test against, and NOT
# good enough to launch on. Until a locale is named here, a request for it is
# served the ENGLISH text and the response says `locale_fell_back: true`.
#
# English is the operator's own risk and they chose it. A Greek legal notice
# nobody read is a risk they did not choose, which is why this defaults to off
# and is an environment variable rather than an admin checkbox: asserting that a
# legal text has been checked is a statement by whoever is accountable for it.
# WITHDRAWAL_VERIFIED_LOCALES=de,el

# Per-minute API budget for a LOGGED-IN staff member, counted per USER.
#
# The anonymous ceiling (RATE_LIMIT_PER_MIN, 60) is right for strangers and was
# also being applied to the people who run the shop — keyed on IP, so everyone
# in one office shared a single bucket. Adding one product is not one request:
# it is the save, the category fetch, the media picker and a POST per photo, so
# ordinary work passed 60 in a couple of minutes and simply stopped.
#
# A session is a credential you issued and can revoke, exactly like an API key,
# so the generous default is defensible. The limit is a runaway-script backstop,
# not a measure against the person logged in.
#
# The default is 1800/min. A catalogue screen is not one request: opening the
# products list, paging through it, opening a product, going back and
# refreshing is hundreds of calls, and the media picker adds one per thumbnail.
# At 600 a staff member doing nothing unusual could be told they were making
# too many requests, with no explanation — and a limit that fires on normal
# work teaches people to ignore the alert. Crawlers and scanners are anonymous
# and stay at RATE_LIMIT_PER_MIN (60/min per IP), which this does not change.
#
# Does NOT affect the login (10 / 15 min) or forgot-password throttles. Those
# protect credentials rather than convenience.
# STAFF_RATE_LIMIT_PER_MIN=1800

# --- Operations -------------------------------------------------------------

# Lets a deploy script read the deep health check without a session:
#   curl -fsS -H "Authorization: Bearer $HEALTH_TOKEN" .../api/health/deep
# 32+ random characters (openssl rand -hex 32). Unset means admin session only
# (everyone else gets 404). A token of 16-31 characters still works but the
# check reports a `health_token` warning; under 16 it is ignored entirely.
# HEALTH_TOKEN=

# --- Media ------------------------------------------------------------------

# Keep the uploaded file alongside its generated derivatives. On by default: the
# original is the shop's master copy of its own photo. It is also the larger
# line item on disk — about 3 MB for a 4000x3000 phone photo, against 80-480 KB
# for all of its derivatives put together. Set to 0 to keep only the web-ready
# set.
# MEDIA_KEEP_ORIGINALS=1

# Camera metadata on the retained original. Stripped by default, LOSSLESSLY —
# the compressed image data is copied through byte for byte, so it is still the
# master copy, but the EXIF block goes. That block carries GPS coordinates and a
# device serial, and the original is fetchable at a guessable /uploads URL: an
# optician photographing stock at home would otherwise publish their home
# address with every product image. Set to `keep` to retain the file byte for
# byte, metadata included.
# MEDIA_ORIGINAL_EXIF=strip

# The largest video the media picker will accept, in megabytes. 100 by default.
# An image ceiling would refuse almost anything a shop actually has — twenty
# seconds of 1080p is comfortably past 10 MB.
#
# It is a real cost, which is why it is yours to set rather than ours to assume:
# the bytes sit on your disk and leave on your bandwidth every time somebody
# presses play, with no CDN in front unless you put one there.
#
# RAISING THIS IS NOT ENOUGH ON ITS OWN. Your reverse proxy has its own body
# limit and refuses the request before the app ever sees it — nginx's default
# would 413 with nothing in the app's log to explain it. Raise
# `client_max_body_size` on /api/media/upload AND /api/media/replace to match
# (this value + 10%, rounded up), or the equivalent in Caddy. The route/constant
# table is in deploy/README.md section 6, and the reference configs are in
# deploy/nginx/ and deploy/caddy/.
# MEDIA_MAX_VIDEO_MB=100

# NOTE: where uploaded images are served FROM is a SETTING, not an environment
# variable — Settings -> "Address of this CMS" (public_site_url). It is editable
# at runtime because a shop that moves domain should not need a rebuild, and the
# deep health check warns when it is unset.

# ---------------------------------------------------------------------------
# Off-site backup (optional)
# ---------------------------------------------------------------------------
# A backup on the same disk as the site is not a backup. Set these and the site
# pushes an archive to any S3-compatible bucket on its own schedule — Backblaze
# B2, Cloudflare R2, Wasabi, Hetzner, MinIO on a second machine. Progress and
# failures show under Admin -> Background jobs.
#
# CREDENTIALS LIVE HERE AND NOWHERE ELSE. They are deliberately not settings:
# the settings table is partly readable by anonymous callers and is schemaless,
# so a bucket secret stored there is one careless projection away from being
# published.
#
# All four are required; with any of them missing, off-site backup is simply
# off (not broken, and nothing is logged).
# BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# BACKUP_S3_BUCKET=my-shop-backups
# BACKUP_S3_KEY_ID=...
# BACKUP_S3_SECRET=...

# The region the endpoint expects. Most S3-compatible providers accept anything
# consistent; AWS does not.
# BACKUP_S3_REGION=us-east-1

# Key prefix inside the bucket, so one bucket can hold several sites.
# BACKUP_S3_PREFIX=astrobaas/myshop

# Path-style URLs (`host/bucket/key`) instead of virtual-host
# (`bucket.host/key`). MinIO and most self-hosted gateways need this.
# BACKUP_S3_PATH_STYLE=1

# https is required. Set this ONLY for a MinIO on your own network — a backup
# carries everything the site knows.
# BACKUP_S3_ALLOW_HTTP=1

# How often, and how many archives to keep. Retention runs only after a
# SUCCESSFUL upload and never removes the archive it just wrote, so the day
# uploads start failing is not the day the last good backup disappears.
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=14
#
# The last attempt and its result are kept in the database (setting
# `offsite_backup_state`), so a restart does not start a fresh backup. An
# attempt that never recorded an outcome — the process died mid-upload —
# blocks another for this long (default 1 h, never longer than the schedule),
# so a crash loop is not also a backup loop. A failed UPLOAD is retried on the
# next sweep; a failure to BUILD the archive waits up to an hour.
# BACKUP_ATTEMPT_TIMEOUT_MS=3600000
#
# NOTE ON DRIVERS: this archives what the ACTIVE driver actually stores —
# db.json for lowdb, the SQLite file for a `file:` libSQL URL, plus the uploads
# directory in both cases. An install on a REMOTE libSQL/Turso database has no
# local file to copy, and the backup refuses rather than archiving a stale
# db.json that would restore to an empty site; use `turso db dump` there.
